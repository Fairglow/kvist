# Kvist project configuration.
# This schema is versioned independently of the Kvist binary.
schema_version = 1

# Directory containing the root component and its descendants.
component_root = "."

[discovery]
# Bounded, deterministic traversal limits. Each has a documented hard maximum.
max_depth = 64
max_directories = 10000
max_components = 10000
max_entries_per_directory = 10000
max_relative_path_bytes = 4096

[vcs]
# `auto` selects exactly one detected supported VCS. Set `git` or `jj` when
# both are present in a colocated checkout.
kind = "auto"

[llm]
# External LLM integration is opt-in. No provider is configured by default.
provider = "none"

# [agent.discovery]
# Optional provider detection and endpoint configuration for 'agent profile add'.
# ollama_url = "http://127.0.0.1:11434"
# llama_server_url = "http://127.0.0.1:8080"
# timeout_seconds = 5
# allow_host_discovery = true

[sandbox]
schema_version = 1
runner = "/opt/target/release/kvist-sandbox-runner"
backend = "/usr/bin/bwrap"
network = "deny"
mount = "component"
environment_allowlist = ["PATH", "RUST_BACKTRACE", "CARGO_HOME", "RUSTC", "TERM"]

[test_policy]
schema_version = 1
working_directory = "component"
environment_allowlist = ["PATH", "RUST_BACKTRACE", "CARGO_HOME", "RUSTC", "TERM"]
timeout_seconds = 1800
max_output_bytes = 1048576

# Per-component verification commands run inside the effect sandbox with the
# component directory as working directory and denied network. They must be
# real test executions (resolved offline from the approved Cargo home cache),
# never placeholders: recorded verification success is compliance evidence.
[[test_policy.commands]]
component = "engine"
command = "cargo test"

[[test_policy.commands]]
component = "agent_runtime"
command = "cargo test"

[[test_policy.commands]]
component = "sandbox_runner"
command = "cargo test"

[agent]

[agent.providers]

# --- Agent / model transport (local) ------------------------------------------
# The supervised task path (`kvist task run`) performs the model turn on the
# host against a local model gateway. Only commands that target a numeric
# loopback endpoint (http://127.0.0.1:<port> or http://[::1]:<port>) are
# accepted; anything else fails the turn with `AgentCommandNotModelGateway`
# before any transport work. The gateway endpoint is extracted from the
# profile command; the runtime transport then issues the actual request.
#
# The concrete local model wiring (gateway URL + model names) is
# machine-specific and is NOT committed. Copy this file to kvist.toml and
# adjust it for your local llama-server. kvist.toml is gitignored so your
# endpoint never lands in the repo. (Alternatively, put [agent.*] in the
# global user config at ~/.config/kvist/config.toml, which Kvist merges in.)
#
# A profile without an explicit `command` uses the provider's synthesized
# default: a curl command against <base_url>/v1/chat/completions (llama-server)
# carrying OpenAI-style chat-completion JSON with the profile's `model` and
# the rendered {prompt_json}. Set the provider's `base_url` (or a profile
# `command` override) when your gateway is not on the default address.
#
# The gateway listens persistently on 127.0.0.1:9931 (--models-max 1). When a
# request names a model that is not loaded, the gateway spawns that model on an
# ephemeral port and transparently routes 9931 -> that port; always address 9931
# with the model name, never the ephemeral port.

[agent.providers.llama-server]
type = "llama-server"
base_url = "http://127.0.0.1:9931"

[agent.profiles.qwen38-27b-q4]
provider = "llama-server"
model = "Qwen3.8-27B-UD-Q4_K_XL"

[agent.profiles.tiel-coder-35b-q4]
provider = "llama-server"
model = "Tiel-Coder-35B-A3B-MTP-UD-Q4_K_XL"

[agent.roles]

[agent.roles.developer]
profile = "tiel-coder-35b-q4"

[agent.roles.architect]
profile = "qwen38-27b-q4"

[agent.roles.security-reviewer]
profile = "qwen38-27b-q4"
