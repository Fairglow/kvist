# Ignore Rust target directories
/target

# Ignore settings and runtime data
/.cargo
/.config/*
!/.config/nextest.toml
/.idea
.kvist
# Shared vendor policy may be version controlled; generated state stays local.
!/.kvist/
/.kvist/*
!/.kvist/vendor.toml
# Ignore skott runtime data (session journals + transcripts)
.skott/
/.vscode
/.zed
skott.toml
kvist.toml

# Ignore temporal files
/*.txt
/*.log
/_*.md
.kvist-attempts
.review-scratch
.vendor-stage-*/
.vendor-write-*
.skott-rust-*/
.maerg-rust-*/
.go-offline-native-*/

# Work documents: one-off findings, evaluations, reviews, and plans that are
# not part of the Kvist durable set. Kept on disk for reference, excluded from
# the committed project.
.work-docs/
