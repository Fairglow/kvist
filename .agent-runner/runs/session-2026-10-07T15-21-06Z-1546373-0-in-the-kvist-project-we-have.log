+            && members.contains(&"galla")
+            && members.contains(&"skott"),
+        "root Cargo.toml must declare maerg, sav, galla, and skott components; members: {members:?}"
+    );
+}
+
+#[test]
+fn top_level_components_are_complete() {
+    let root = repository_root();
+    for component in ["maerg", "sav", "galla", "skott"] {
+        let dir = root.join(component);
+        let missing = COMPONENT_ARTIFACTS
