+            .chain(["Cargo.toml", "src", "tests"].iter())
+            .filter(|path| !dir.join(path).exists())
+            .copied()
+            .collect::<Vec<_>>();
+        assert!(
+            missing.is_empty(),
+            "{} must be a complete buildable component; missing: {missing:?}",
+            dir.display()
+        );
+    }
+}
