+fn workspace_is_owned_by_the_repository_root() {
+    let root = repository_root();
+    // kvist.toml is machine-local (gitignored); the tracked template is the
+    // durable configuration artifact owned by the repository root.
+    let required = [
+        "Cargo.toml",
+        "Cargo.lock",
+        "VISION.md",
+        "ARCHITECTURE.md",
+        "ROOT_CONTRACT.md",
+        "kvist.toml.example",
+    ];
