/// True when the row renders as an empty (whitespace-only) line.
fn row_is_blank(line: &ScreenLine) -> bool {
    let text = line.line.to_string();
    // reasoning rows carry the edge glyph, so they're never blank; strip it.
    let text = text
        .strip_prefix(REASONING_EDGE_FIRST)
        .or_else(|| text.strip_prefix(REASONING_EDGE_CONT))
        .unwrap_or(&text);
    text.trim().is_empty()
}
```

