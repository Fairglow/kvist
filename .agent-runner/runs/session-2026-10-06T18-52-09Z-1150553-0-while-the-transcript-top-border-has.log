```rust
/// Ensures the transcript's last line is blank (adds one if needed), so a
/// following block is visually separated. No-op when already blank.
fn ensure_blank_before_block(&mut self) {
    if let Some(last) = self.lines.last() {
        if !row_is_blank(last) {
            self.lines.push(blank_line());
        }
    }
}

/// Ensures the transcript ends with a blank line after a block just appended,
/// so the following content is separated. No-op when already blank.
fn ensure_blank_after_block(&mut self) {
    if !self.lines.is_empty() {
        if let Some(last) = self.lines.last() {
            if !row_is_blank(last) {
                self.lines.push(blank_line());
            }
        }
    }
}

fn blank_line() -> ScreenLine {
    ScreenLine {
        line: Line::from(""),
        kind: LineKind::Normal,
        md: None,
        bg: self.theme.panel_bg,  // need &self...
    }
}
```

