/// Advised: which configurable profiles a project *uses*, from root manifests
/// that are NOT ignored by the project's `.gitignore`.
pub fn detect_languages_in(dir: &Path) -> BTreeSet<ToolProfile> {
    let entries = match std::fs::read_dir(dir) {
        Ok(dir) => dir.flatten().map(|e| e.file_name().to_string_lossy().into_owned()).collect(),
        Err(_) => return BTreeSet::new(),
    };
    let gitignore = read_gitignore(dir);
    let filtered: Vec<String> = entries
        .into_iter()
        .filter(|name| {
            let is_dir = dir.join(name).is_dir(); // careful shadowing 'dir'
            !gitignore.is_entry_ignored(name, is_dir)
        })
        .collect();
    let refs: Vec<&str> = filtered.iter().map(String::as_str).collect();
    detect_languages(&refs)
}
```

