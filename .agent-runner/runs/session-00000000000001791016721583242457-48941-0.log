fn matches_path(pattern_line, name, is_dir) -> Option<bool> {
    let mut line = pattern_line;
    if line.is_empty() { return None; }
    // strip comments
    if line.starts_with('#') { return None; }
    let negation = line.starts_with('!');
    if negation { line = &line[1..]; }
    if line.starts_with('!') { line = &line[1..]; } // defensive
    // trailing '!' strips trailing exclamation (escape); rare, skip handling for now but we can strip trailing '!'
    
    // directory-only flag
    let dir_only = line.ends_with('/');
    if dir_only { line = &line[..line.len()-1]; }
    if !dir_only && line.is_empty() { return None; }
    
    // anchored?
    let anchored = line.starts_with('/');
    if anchored { line = &line[1..]; }
    // if line empty after removing leading slash and trailing slash -> skip
    
    // Now match `line` against `name`.
    // Since we match a single top-level component, a multi-segment pattern (line contains '/')
    // only matches if it equals name exactly (single segment) — but it has '/', so it won't match a plain name.
    // We still implement segment-based matching for robustness:
    
    // Split into segments by '/'
    let segments: Vec<&str> = line.split('/').collect();
    let name_segments: Vec<&str> = name.split('/').collect();
    if segments.len() != name_segments.len() {
        return None; // different depth structure
