```rust
/// A parsed `.gitignore`: an ordered list of pattern entries. The first
/// matching pattern (in file order) wins, following `.gitignore`'s
/// last-match-wins semantics; negations (`!...`) re-include a previously
/// ignored entry.
#[derive(Debug, Default, Clone)]
pub struct GitIgnore {
    entries: Vec<IgnoreEntry>,
}

#[derive(Debug, Clone)]
struct IgnoreEntry {
    negation: bool,
    dir_only: bool,
    segments: Vec<String>,
}

impl GitIgnore {
    /// Parses the raw contents of a `.gitignore` file. Blank lines and `#`
    /// comments are skipped. A missing file parses to an empty matcher.
    pub fn parse(contents: &str) -> Self {
        let mut entries = Vec::new();
        for raw in contents.lines() {
            let line = raw.strip_suffix('\r').unwrap_or(raw);
            let trimmed = line.trim_end();
            if trimmed.is_empty() || trimmed.starts_with('#') {
                continue;
            }
            let negation = trimmed.starts_with('!');
            let mut body = if negation { &trimmed[1..] } else { trimmed };
            // A trailing `!` escapes a literal `!` at the end of the pattern.
            body = body.strip_suffix('!').unwrap_or(body);
            if body.is_empty() {
                continue;
            }
            let dir_only = body.ends_with('/');
            body = body.strip_suffix('/').map(str::trim_end).unwrap_or(body);
            if body.is_empty() {
                continue;
            }
            let segments: Vec<String> = body.split('/').map(String::from).collect();
            entries.push(IgnoreEntry { negation, dir_only, segments });
        }
        GitIgnore { entries }
    }

    /// Reads and parses `.gitignore` from `dir` if present. A missing or
    /// unreadable file yields an empty matcher (nothing is ignored).
    pub fn read(dir: &Path) -> Self {
        let path = dir.join(".gitignore");
        match std::fs::read_to_string(&path) {
            Ok(contents) => GitIgnore::parse(&contents),
            Err(_) => GitIgnore::default(),
        }
    }

    /// Whether a single top-level entry `name` is ignored by this matcher,
    /// honoring last-match-wins semantics. `is_dir` lets directory-only
    /// patterns (trailing `/`) apply correctly.
    pub fn is_entry_ignored(&self, name: &str, is_dir: bool) -> bool {
        let mut ignored = false;
        for entry in &self.entries {
            if let Some(value) = entry.matches(name, is_dir) {
                ignored = value;
            }
        }
        ignored
    }
}

impl IgnoreEntry {
    fn matches(&self, name: &str, is_dir: bool) -> Option<bool> {
        let pat: Vec<&str> = self.segments.iter().map(String::as_str).collect();
        let name_segs: Vec<&str> = name.split('/').collect();
        if !segments_match(&pat, &name_segs) {
            return None;
        }
        if self.dir_only && !is_dir {
            return None;
        }
        Some(!self.negation)
    }
}

/// Whether a top-level entry `name` is ignored by the project's `.gitignore`,
/// if one exists at `dir`. A project without a `.gitignore` ignores nothing.
pub fn is_gitignored(dir: &Path, name: &str, is_dir: bool) -> bool {
    GitIgnore::read(dir).is_entry_ignored(name, is_dir)
}
```

