                    match txt.first() {
                        Some(c) if *c == '[' => glob(&pat[1..], &txt[1..]),
                        _ => false,
                    }
                }
            }
        }
        Some(pc) => {
            match txt.first() {
                Some(tc) if *tc == *pc => glob(&pat[1..], &txt[1..]),
                _ => false,
            }
        }
    }
}
