fn glob_match(pattern: &str, text: &str) -> bool {
    // Classic wildcard matching with *, ?, [..]
    let p: Vec<char> = pattern.chars().collect();
    let t: Vec<char> = text.chars().collect();
    let (mut pi, mut ti) = (0usize, 0usize);
    let (mut star, backtrack_pi, backtrack_ti) = (None, 0usize, 0usize);
    while ti < t.len() {
        if pi < p.len() && (p[pi] == '?' || p[pi] == t[ti]) {
            pi += 1; ti += 1;
        } else if pi < p.len() && p[pi] == '*' {
            star = Some(pi); backtrack_ti = ti; backtrack_pi = pi + 1;
            pi = backtrack_pi;
        } else if let Some(prev_star) = star {
            pi = prev_star;
            backtrack_ti += 1;
            ti = backtrack_ti;
        } else {
            return false;
        }
    }
    while pi < p.len() && p[pi] == '*' { pi += 1; }
    pi == p.len()
}
```

