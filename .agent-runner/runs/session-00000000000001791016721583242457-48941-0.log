fn wildcard_match(pattern: &[char], text: &[char]) -> bool {
    let mut pi = 0;
    let mut ti = 0;
    let mut star = None; // pattern index of last '*', and text index to retry
    loop {
        if pi < pattern.len() && pattern[pi] != '*' {
            // handle '?' and '[']
            if pi < pattern.len() && pattern[pi] == '?' {
                if ti >= text.len() {
                    if let Some((sp, st)) = star { pi = sp+1; ti = st; } else { return false; }
                    continue;
                }
                pi += 1; ti += 1; continue;
            }
            if pi < pattern.len() && pattern[pi] == '[' {
                // match one char in bracket
                match bracket_match(pattern, pi, text, ti) {
                    Ok((next_pi,)) => { if ti >= text.len() { ... } ; pi = next_pi; ti += 1; continue; }
                    Err(()) => { /* try backtrack */ ... }
                }
            }
            if ti < text.len() && pattern[pi] == text[ti] {
                pi += 1; ti += 1; continue;
            }
        }
        if pi < pattern.len() && pattern[pi] == '*' {
            // record backtrack, advance pattern
            star = Some((pi, ti));
            pi += 1;
            continue;
        }
        // if not at end of pattern
