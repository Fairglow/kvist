fn pattern_matches(pattern_line: &str, name: &str, is_dir: bool) -> Option<bool> {
    let mut line = pattern_line;
    // gitignore: lines may end with \r (Windows)
    line = line.strip_suffix('\r').unwrap_or(line);
    // skip blank / comment lines
    let trimmed = line.trim_end(); // gitignore trims trailing whitespace unless escaped
    // Actually we should handle trailing whitespace; trailing spaces are significant only if escaped. For simplicity, trim trailing whitespace.
    if trimmed.is_empty() {
        return None;
    }
    if trimmed.starts_with('#') {
        return None;
    }
    let negation = trimmed.starts_with('!');
    let body = if negation { &trimmed[1..] } else { trimmed };
    // trailing '!' escapes a literal '!' at end of pattern; strip trailing '!'
    let body = body.strip_suffix('!').unwrap_or(body);
    if body.is_empty() {
        return None;
    }
    // trailing '!' handling already done. Now dir-only:
    let dir_only = body.ends_with('/');
    let body = if dir_only { &body[..body.len()-1] } else { body };
    if body.is_empty() {
        return None;
    }
    let anchored = body.starts_with('/');
    let body = if anchored { &body[1..] } else { body };
    if body.is_empty() {
        return None;
