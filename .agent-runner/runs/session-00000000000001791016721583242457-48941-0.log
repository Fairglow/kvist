impl GitIgnore {
    fn matched(&self, name: &str, is_dir: bool) -> bool {
        let mut ignored = false;
        for entry in &self.entries {
            if let Some(value) = pattern_matches(&entry.pattern, name, is_dir) {
                ignored = value;
            }
        }
        ignored
    }
}
