```rust
/// A parsed subset of a project's `.gitignore`, used only for the advisory
/// language detection so that entries the project ignores (dev tooling, build
/// output, …) are not mistaken for languages the project uses.
#[derive(Default)]
pub struct GitIgnore {
    /// Each rule is `(negated, pattern)`, in file order. The last matching rule
    /// wins, matching git's semantics.
    rules: Vec<(bool, String)>,
}

impl GitIgnore {
    /// Parse a `.gitignore` document from its text. Empty/absent content yields
    /// a matcher that ignores nothing.
    pub fn parse(content: &str) -> Self {
        let mut rules = Vec::new();
        for raw in content.lines() {
            let line = raw.trim();
            if line.is_empty() || line.starts_with('#') {
                continue;
            }
            let (negated, pattern) = match line.strip_prefix('!') {
                Some(rest) => (true, rest.trim().to_owned()),
                None => (false, line.to_owned()),
            };
            rules.push((negated, pattern));
        }
        Self { rules }
    }

    /// Whether `name` (a single top-level entry name, file or directory) is
    /// ignored by this file.
    pub fn matches(&self, name: &str) -> bool {
        let mut ignored = false;
        for (negated, pattern) in &self.rules {
            if self.pattern_matches(pattern, name) {
                ignored = !*negated;
            }
        }
        ignored
    }

    fn pattern_matches(&self, pattern: &str, name: &str) -> bool {
        // A trailing slash marks a directory-only pattern.
        let (dir_only, pattern) = match pattern.strip_suffix('/') {
            Some(rest) => (true, rest),
            None => (false, pattern),
        };
        let anchored = pattern.starts_with('/');
        let pattern = pattern.strip_prefix('/').unwrap_or(pattern);
        // A slash inside the pattern anchors it relative to the .gitignore's
        // directory; for top-level entries this is equivalent to the basename.
        let anchored = anchored || pattern.contains('/');
        // The core of the pattern after any leading `**`.
        let core = pattern.strip_prefix("**/").unwrap_or(pattern);
        if dir_only {
            // Directory-only patterns never match a file entry.
            let _ = name;
            return false;
        }
        if anchored {
            core == name
        } else {
            core == name || name.ends_with(&format!("/{}", core))
        }
    }
}
```

