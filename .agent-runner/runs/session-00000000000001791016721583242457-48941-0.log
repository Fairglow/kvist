```rust
#[derive(Debug, Clone)]
enum Token {
    Lit(u8),
    Any,
    Star,
    Class { neg: bool, set: [bool; 256] },
}
```

`parse_tokens`:

```rust
fn parse_tokens(pattern: &str) -> Vec<Token> {
    let b = pattern.as_bytes();
    let mut tokens = Vec::new();
    let mut i = 0;
    while i < b.len() {
        match b[i] {
            b'*' => { tokens.push(Token::Star); i += 1; }
            b'?' => { tokens.push(Token::Any); i += 1; }
            b'[' => {
                i += 1;
                let mut neg = false;
                if i < b.len() && (b[i] == '!' || b[i] == '^') {
                    neg = true;
                    i += 1;
                }
                let mut set = [false; 256];
                // handle ']' as literal when it's the first char of the class
                let mut closed = false;
                if i < b.len() && b[i] == ']' {
                    set[b[i] as usize] = true;
                    i += 1;
                }
                while i < b.len() && b[i] != ']' {
                    // range a-z
                    if i + 2 < b.len() && b[i+1] == '-' && b[i+2] != ']' {
                        let lo = b[i];
                        let hi = b[i+2];
                        for code in lo..=hi {
                            set[code as usize] = true;
                        }
                        i += 3;
                    } else {
                        set[b[i] as usize] = true;
                        i += 1;
                    }
                }
                if i < b.len() && b[i] == ']' {
                    closed = true;
                    i += 1;
                }
                if closed {
                    tokens.push(Token::Class { neg, set });
                } else {
                    // not a valid class; treat '[' as literal
                    tokens.push(Token::Lit(b'['));
                }
            }
            other => {
                tokens.push(Token::Lit(other));
                i += 1;
            }
        }
    }
    tokens
}
