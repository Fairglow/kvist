```rust
fn segment_match(tokens: &[Token], text: &str) -> bool {
    let t: Vec<char> = text.chars().collect();
    let n = tokens.len();
    let mut pi = 0usize;
    let mut ti = 0usize;
    let mut star_pi = 0usize;   // index of the last star token seen
    let mut star_ti = 0usize;   // ti right after the star (how far ti advanced with that star)
    let mut ti_after_star = 0usize; // next ti to try when backtracking into this star
    let mut has_star = false;
    while ti < t.len() {
        if pi < n {
            let matches_here = match &tokens[pi] {
                Token::Star => false,
                Token::Char(c) => *c == t[ti],
                Token::Any => true,
                Token::Class { negated, ranges } => {
                    let in_range = ranges.iter().any(|(lo,hi)| *lo<=t[ti]&&t[ti]<=*hi);
                    !negated == in_range
                }
            };
            if matches_here {
                pi += 1; ti += 1;
                continue;
            }
        }
        // current position doesn't match; handle star
        if pi < n && matches!(tokens[pi], Token::Star) {
            star_pi = pi;
            star_ti = pi + 1;
            ti_after_star = ti;
            has_star = true;
            pi = star_ti;
            continue;
        }
        if has_star {
            pi = star_pi + 1;
            ti_after_star += 1;
            ti = ti_after_star;
            continue;
        }
        return false;
    }
    while pi < n && matches!(tokens[pi], Token::Star) {
        pi += 1;
    }
    pi == n
}
```

