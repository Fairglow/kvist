fn tokenize(pat: &str) -> Vec<Token> {
    let chars: Vec<char> = pat.chars().collect();
    let mut i = 0;
    let mut out = Vec::new();
    while i < chars.len() {
        let c = chars[i];
        match c {
            '*' => { out.push(Token::Star); i += 1; }
            '?' => { out.push(Token::Any); i += 1; }
            '[' => {
                // find closing ]
                // handle leading ^ or ! as negation
                let mut j = i + 1;
                let mut negated = false;
                if j < chars.len() && (chars[j] == '!' || chars[j] == '^') {
                    negated = true; j += 1;
                }
                // a ] right after [ or [! is literal
                if j < chars.len() && chars[j] == ']' { j += 1; }
                let start = j;
                while j < chars.len() && chars[j] != ']' { j += 1; }
                if j >= chars.len() {
                    // no closing bracket; treat [ as literal
                    out.push(Token::Char('['));
                    i += 1;
                    continue;
                }
                // parse ranges between start..j
                let mut ranges = Vec::new();
                let mut k = start;
                while k < j {
                    let lo = chars[k];
                    // check range lo-hi
                    if k + 2 < j+1 && k+2 <= j && chars[k+1] == '-' && k+2 < j {
                        // Actually range: lo '-' hi, hi = chars[k+2], ensure k+2 < j
                    }
                    ...
                }
                ...
            }
            _ => { out.push(Token::Char(c)); i += 1; }
        }
    }
    out
}
```

