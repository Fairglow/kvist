    // last segment can be directory-only (from dir_only flag)
    for (i, seg) in segments.iter().enumerate() {
        // check wildcard
        let matched = glob_match(seg, &name_segments[i]);
        if !matched { return None; }
        // directory-only applies to the last segment
        if dir_only && i != segments.len()-1 {
            return None;
        }
    }
    if dir_only && !is_dir {
        return None;
    }
    
    // Matched! Return ignored state.
    Some(!negation)
}
