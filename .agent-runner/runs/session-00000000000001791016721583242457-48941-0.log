```rust
fn compile_line(line: &str) -> Option<CompiledPattern> {
    let mut negated = false;
    let mut rest = line;
    if let Some(r) = rest.strip_prefix('!') {
        negated = true;
        rest = r;
    }
    if rest.is_empty() {
        return None;
    }

    // Anchoring: a leading '/' anchors to the top level; also any '/' later
    // (a non-trailing slash) anchors to the location of the .gitignore.
    let mut anchored = false;
    let mut dir_only = false;

    let body = {
        let mut s = rest;
        if s.starts_with('/') {
            anchored = true;
            s = &s[1..];
        }
        if s.ends_with('/') {
            dir_only = true;
            s = &s[..s.len() - 1];
        }
        s
    };
    // After stripping, anchored should also be set if body contains a '/'.
    if body.contains('/') {
        anchored = true;
    }

    if body.is_empty() {
        return None;
    }

    // Strip trailing spaces that are not backslash-escaped.
    // Handle backslash escapes: '\n','\ ','\#','\!','\\','\[' etc.
    let segments: Vec<&str> = body.split('/').collect();
    let tokens: Vec<Vec<Token>> = segments
        .iter()
        .map(|seg| tokenize_segment(seg))
        .collect();

    Some(CompiledPattern {
        negated,
        anchored,
        dir_only,
        segments: tokens,
    })
}
```

