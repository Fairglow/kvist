Let me implement wildcard with a token list and a simple backtracking:

```rust
fn wildcard(tokens: &[Token], pi: usize, text: &[u8], ti: usize) -> bool {
    if pi == tokens.len() {
        return ti == text.len();
    }
    match &tokens[pi] {
        Token::Lit(c) => {
            if ti < text.len() && text[ti] == *c {
                wildcard(tokens, pi + 1, text, ti + 1)
            } else {
                false
            }
        }
        Token::Any => {
            if ti < text.len() {
                wildcard(tokens, pi + 1, text, ti + 1)
            } else {
                false
            }
        }
        Token::Class(neg, set) => {
            if ti < text.len() {
                let contained = set[text[ti] as usize];
                let matches = if *neg { !contained } else { contained };
                if matches {
                    wildcard(tokens, pi + 1, text, ti + 1)
                } else {
                    false
                }
            } else {
                false
            }
        }
        Token::Star => {
            // '*' matches zero or more chars
            let mut k = ti;
            loop {
                if wildcard(tokens, pi + 1, text, k) {
                    return true;
                }
                if k < text.len() {
                    k += 1;
                } else {
                    return false;
                }
            }
        }
    }
}
```

