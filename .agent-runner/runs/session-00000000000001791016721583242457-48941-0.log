fn segment_match(pattern: &str, text: &str) -> bool {
    // match a single path segment; '*' matches any run, '?' any char, '[...]' class
    // returns false if pattern contains '/' (shouldn't, segments are split)
    let ptokens = parse_tokens(pattern);
    let tbytes: Vec<u8> = text.as_bytes().to_vec();
    wildcard(&ptokens, 0, &tbytes, 0)
}
