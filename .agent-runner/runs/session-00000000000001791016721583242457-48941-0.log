impl Rule {
    fn matches(&self, components: &[&str], is_dir: bool) -> bool {
        if self.dir_only && !is_dir {
            return false;
        }
        let rest_components: Vec<&str> = self.pattern.split('/').collect();
        if self.anchored {
            if rest_components.len() > components.len() {
                return false;
            }
            // match rest_components against the leading components
            for (idx, rc) in rest_components.iter().enumerate() {
                let c = components[idx];
                // last component may have trailing slash? no, we stripped.
                if idx == rest_components.len() - 1 && rc.ends_with('/') {
                    // dir-only pattern anchored, need it to be a dir OR match deeper
                    // treat like dir_only
                    if !is_dir { return false; }
                    let rc = &rc[..rc.len()-1];
                    if !glob_split(rc, c) { return false; }
                } else {
                    if !glob_split(rc, c) { return false; }
                }
            }
            true
        } else {
            // match against basename = last component
            let name = components.last().unwrap_or("");
            glob_split(self.pattern, name)
        }
    }
}
```

