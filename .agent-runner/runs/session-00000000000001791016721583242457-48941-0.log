/// that are not excluded by the project's own `.gitignore`. This is advisory
/// only (it informs logging and recommendations); it never gates use, which is
/// decided solely by tool-chain availability inside the sandbox. Ignoring the
/// project's `.gitignore` keeps the advisory honest: files present only as a
/// side effect of local tooling (for example a gitignored `package.json` or
/// `node_modules/`) no longer make the project appear to use that language.
pub fn detect_languages_in(dir: &Path) -> BTreeSet<ToolProfile> {
