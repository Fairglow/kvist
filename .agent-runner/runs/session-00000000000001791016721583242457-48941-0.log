```rust
/// Reads a project's `.gitignore` from `dir`, if present, into a matcher.
/// A missing or unreadable `.gitignore` yields an empty matcher (nothing ignored).
pub fn read_gitignore(dir: &Path) -> GitIgnore {
    let path = dir.join(".gitignore");
    match std::fs::read_to_string(&path) {
        Ok(contents) => GitIgnore::parse(&contents),
        Err(_) => GitIgnore::default(),
    }
}

/// Returns true when a top-level entry `name` (with `is_dir`) is ignored by `self`.
pub fn is_entry_ignored(&self, name: &str, is_dir: bool) -> bool {
    self.matched(name, is_dir)
}
```

