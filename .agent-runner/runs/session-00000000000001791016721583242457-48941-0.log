First, gitignore.rs:

```rust
//! Minimal, dependency-free `.gitignore` pattern matcher.
//!
//! This implements the subset of git's ignore semantics needed to decide,
//! from a project root, whether a top-level entry is part of the project or
//! is excluded by a `.gitignore` file. It is intentionally narrow: it supports
//! anchoring (leading `/` and any embedded `/`), directory-only patterns
//! (trailing `/`), negation (`!`), and the `*`, `?` and `[...]` glob
//! metacharacters. It does not implement everything in git's ignore
//! documentation (line continuation, the `git check-ignore` precedence
//! subtleties around re-including files under an ignored directory, etc.),
//! which is acceptable for advisory top-level detection.
//!
//! It must not be used for the capability gate (`language_available`): that
//! judges what reaches the sandbox and must stay manifest- and ignore-blind.

use std::collections::BTreeMap;
use std::path::Path;

/// A single token in a tokenized gitignore pattern.
#[derive(Debug, Clone, PartialEq, Eq)]
enum Token {
    /// A literal character.
    Char(char),
    /// `?` — matches any single character except `/`.
    Any,
    /// `*` — matches any run of characters except `/`.
    Star,
    /// A `[...]` character class.
    Class {
        negated: bool,
        ranges: Vec<(char, char)>,
    },
}

/// A compiled, ordered ignore pattern.
#[derive(Debug, Clone)]
struct CompiledPattern {
    negated: bool,
    anchored: bool,
    dir_only: bool,
    segments: Vec<Vec<Token>>,
}

/// A parsed collection of ignore patterns, in file order.
#[derive(Debug, Clone, Default)]
pub struct GitIgnore {
    patterns: Vec<CompiledPattern>,
}

impl GitIgnore {
    /// Parse the textual contents of a `.gitignore` file.
    pub fn parse(text: &str) -> Self {
        let mut patterns = Vec::new();
        for line in text.lines() {
            // A line whose first character is `#` is a comment. A `#` later in
            // the line is literal unless escaped with a backslash, and the
            // parser below treats `\#` as a literal `#`.
            let trimmed = if let Some(stripped) = line.strip_prefix('\\') {
                // Backslash-escaped first character (e.g. `\#`) — keep it.
                stripped
            } else {
                line
            };
            if trimmed.is_empty() || trimmed.starts_with('#') {
                continue;
            }
            if let Some(pattern) = compile_line(trimmed) {
                patterns.push(pattern);
            }
        }
        GitIgnore { patterns }
    }

    /// Parse `dir/.gitignore`, returning an empty matcher if it is absent or
    /// unreadable.
    pub fn from_dir(dir: &Path) -> Self {
        let path = dir.join(".gitignore");
        match std::fs::read_to_string(&path) {
            Ok(text) => Self::parse(&text),
            Err(_) => Self::default(),
        }
    }

    /// Whether `rel_path` (a path relative to the directory that owns this
    /// matcher) is ignored. `is_dir` must reflect whether the path is a
    /// directory.
    pub fn is_ignored(&self, rel_path: &str, is_dir: bool) -> bool {
        let mut ignored = false;
        for pattern in &self.patterns {
            if pattern.matches(rel_path, is_dir) {
                ignored = !pattern.negated;
            }
        }
        ignored
    }
}
