```rust
impl Section {
    /// Whether this section is large enough to warrant an encapsulating
    /// background. Large blocks are multi-line prose / reasoning / the prompt.
    /// Short operational lines (tool calls and their results) stay grouped
    /// under a single subtle background and are told apart by text colour alone.
    fn is_large_block(self) -> bool {
        matches!(self, Section::Prompt | Section::Reasoning)
    }

    /// The encapsulating background for one [`Section`], tuned for a dark
    /// terminal.
    ///
    /// Large blocks (the prompt, reasoning) each get their own distinct, subtle
    /// tint so they read apart. Tool calls and their results share one neutral,
    /// near-black background so an `→ tool: …` line and its `✓ … finished`
    /// result stay visually grouped, and are distinguished by their green/red
    /// text colour rather than a differing background. Returns `None` for
    /// sections that should carry no background.
    fn background(self) -> Option<Color> {
        let tint = match self {
            Section::Prompt => Color::Rgb(46, 50, 64),
            Section::Reasoning => Color::Rgb(34, 34, 38),
            // Shared, suitably black background for the tool action + its result.
            Section::ToolCall | Section::ToolResult | Section::ToolResultFailure => {
                Color::Rgb(28, 28, 30)
            }
        };
        Some(tint)
    }
