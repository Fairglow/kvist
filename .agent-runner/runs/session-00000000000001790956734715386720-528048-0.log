```rust
impl Section {
    /// The single, near-black background shared by tool calls and tool
    /// results. Grouping them under one neutral, deliberately dark tint keeps a
    /// proposed call visually attached to its result; the two are told apart by
    /// text colour alone (blue for the call, green/red for success/failure), so
    /// the shared background never competes with that signal.
    const TOOL_BACKGROUND: Color = Color::Rgb(30, 30, 31);

    /// The background tint for one [`Section`], tuned for a dark terminal. Large
    /// blocks — the prompt and model reasoning — each get their own distinct,
    /// deliberately dark tint so they read apart. Tool calls and tool results
    /// instead share a single neutral, near-black tint (see
    /// [`Section::TOOL_BACKGROUND`]) so a call stays grouped with its result.
    /// Every tint is kept dark so it complements the foreground colour coding
    /// rather than competing with it.
    ///
    /// The tint fills the full inner width of the transcript box: the bordered
    /// paragraph paints each row's background across every column the line
    /// occupies, leaving only the box's own left and right borders out. Callers
    /// combine it with the section's foreground via [`Style::patch`], preserving
    /// the foreground colour and modifiers while filling in only the background.
    fn background(self) -> Color {
        match self {
            Section::Prompt => Color::Rgb(46, 50, 64),
            Section::Reasoning => Color::Rgb(34, 34, 38),
            Section::ToolCall | Section::ToolResult | Section::ToolResultFailure => Self::TOOL_BACKGROUND,
        }
    }
}

fn section_background(section: Section) -> Style {
    Style::default().bg(section.background())
}
```

