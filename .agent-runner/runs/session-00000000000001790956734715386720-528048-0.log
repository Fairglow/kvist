```rust
/// A transcript content section. Content that forms a larger block — the echoed
/// prompt, model reasoning — gets its own subtle, low-intensity background so it
/// reads as an encapsulated block. The tool call / result group shares one
/// near-black background, so a proposed call and its result are kept together as
/// a unit and told apart by their foreground text colour instead.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum Section {
    /// The user's prompt as echoed into the transcript (`You: …`).
    Prompt,
    /// Model reasoning / thinking, already rendered dim.
    Reasoning,
    /// A proposed tool call (`→ tool: …`).
    ToolCall,
    /// A tool's finished result (success).
    ToolResult,
    /// A failed tool result.
    ToolResultFailure,
}

/// The near-black background shared by the whole tool call / result group, so a
/// call and its result read together. Kept just above pure black so it forms a
/// subtle box against the terminal without dulling the foreground text colours.
const TOOL_BACKGROUND: Color = Color::Rgb(18, 18, 20);

fn section_background(section: Section) -> Style {
    let tint = match section {
        Section::Prompt => Color::Rgb(46, 50, 64),
        Section::Reasoning => Color::Rgb(34, 34, 38),
        // Tool call / result group: one near-black so they're kept together;
        // meaning comes from the foreground colour (blue / green / red).
        Section::ToolCall
        | Section::ToolResult
        | Section::ToolResultFailure => TOOL_BACKGROUND,
    };
    Style::default().bg(tint)
}
```

