```rust
impl Section {
    /// Whether this section is large enough to warrant an encapsulating
    /// background. Large blocks are multi-line prose / reasoning / the prompt;
    /// short operational lines are left background-free.
    fn is_large_block(self) -> bool {
        matches!(self, Section::Prompt | Section::Reasoning)
    }

    /// A subtle, low-intensity background for one [`Section`], tuned for a dark
    /// terminal. Each large block gets a distinct tint so sections read apart, but
    /// every tint is intentionally dark so it complements (rather than competes
    /// with) the existing foreground colour coding. The background fills the full
    /// inner width of the transcript box (excluding the box's own borders) because
    /// it rides the per-line style that the bordered paragraph paints across every
    /// column the line occupies; callers combine it with the section's existing
    /// foreground via [`Style::patch`], keeping the foreground colour and modifiers
    /// while filling in only the background. Returns `None` for inline, short
    /// sections, which intentionally carry no background.
    fn background(self) -> Option<Color> {
        if !self.is_large_block() {
            return None;
        }
        let tint = match self {
            Section::Prompt => Color::Rgb(46, 50, 64),
            Section::Reasoning => Color::Rgb(34, 34, 38),
            _ => unreachable!("is_large_block() only true for Prompt or Reasoning"),
        };
        Some(tint)
    }
}

fn section_background(section: Section) -> Style {
    match section.background() {
        Some(tint) => Style::default().bg(tint),
        None => Style::default(),
    }
}
```

