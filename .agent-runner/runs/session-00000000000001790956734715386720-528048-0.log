tool stdout: impl Section {
    /// The background colour for this section. Large blocks each get a distinct,
    /// intentionally dark tint so they read as separate encapsulated boxes, while
    /// every tool-related section shares one neutral, suitably dark background so
    /// a call and its result group together. Callers combine it with the section's
    /// existing foreground via [`Style::patch`], keeping the foreground colour and
    /// modifiers while filling in only the background; the background fills the
    /// full inner width of the transcript box because it rides the per-line style
    /// the bordered paragraph paints across every column the line occupies.
    fn background(self) -> Color {
        match self {
            Section::Prompt => Color::Rgb(46, 50, 64),
            Section::Reasoning => Color::Rgb(34, 34, 38),
            // One neutral, suitably dark background shared by the whole tool
            // group. It is close to black so it groups call and result without
            // competing with the green/red/blue text that carries their meaning.
            _ => Color::Rgb(30, 30, 32),
        }
    }
}

