tool stdout: /// A transcript content section. Large blocks — multi-line prose, model
/// reasoning, or the echoed prompt — get a subtle, low-intensity background so
/// they read as clearly separated, encapsulated boxes that fill the transcript's
/// full inner width (the box's own borders excluded). Short operational lines —
/// tool calls and results — share one suitably dark, neutral background instead,
/// so a call and its result read as a single grouped unit; their success or
/// failure is read from the text colour, not the background.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum Section {
    /// The user's prompt as echoed into the transcript (`You: \u{2026}`). Large block.
    Prompt,
    /// Model reasoning / thinking, already rendered dim. Large block.
    Reasoning,
    /// A proposed tool call (`\u{2192} tool: \u{2026}`). Shares the tool group background;
    /// distinguished from its result only by the blue text colour.
    ToolCall,
    /// A tool's finished result (success). Shares the tool group background with
    /// its call; success is read from the green text colour.
    ToolResult,
    /// A failed tool result. Shares the tool group background with its call;
    /// failure is read from the red text colour.
    ToolResultFailure,
}

impl Section {
    /// The background colour for this section. Large blocks each get a distinct,
    /// intentionally dark tint so they read as separate encapsulated boxes, while
    /// every tool-related section shares one neutral, suitably dark background so
    /// a call and its result group together. Callers combine it with the section's
    /// existing foreground via [`Style::patch`], keeping the foreground colour and
    /// modifiers while filling in only the background; the background fills the
    /// full inner width of the transcript box because it rides the per-line style
    /// the bordered paragraph paints across every column the line occupies.
    fn background(self) -> Color {
        match self {
            Section::Prompt => Color::Rgb(46, 50, 64),
            Section::Reasoning => Color::Rgb(34, 34, 38),
            // One neutral, suitably dark background shared by the whole tool
            // group. It is close to black so it groups call and result without
            // competing with the green/red/blue text that carries their meaning.
            _ => Color::Rgb(30, 30, 32),
        }
    }
}

/// Applies one [`Section`]'s background to a style, keeping the foreground
/// colour and modifiers and filling in only the background. Large blocks get a
/// distinct, intentionally dark tint; every tool-related section shares one
/// neutral, suitably dark background so a call and its result group together.
fn section_background(section: Section) -> Style {
    Style::default().bg(section.background())
}

/// Maximum number of transcript lines retained before dropping the oldest.
const MAX_LINES: usize = 5000;
/// The braille spinner frames cycled in the header while a turn generates.
const SPINNER_FRAMES: [&str; 8] = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧"];
/// Milliseconds per spinner frame; the loop redraws each tick, so this sets the
/// visible spin rate.

