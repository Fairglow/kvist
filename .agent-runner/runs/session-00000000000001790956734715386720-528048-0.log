```rust
/// A transcript content section. Sections that share a visual grouping also
/// share a background: the echoed prompt and model reasoning each read as their
/// own encapsulated block with a distinct, subtle, low-intensity tint, while the
/// tool call / result group shares one near-black background so a proposed call
/// and its result stay grouped as a unit and are told apart by their foreground
/// text colour instead.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum Section {
    /// The user's prompt as echoed into the transcript (`You: …`).
    Prompt,
    /// Model reasoning / thinking, already rendered dim.
    Reasoning,
    /// A proposed tool call (`→ tool: …`).
    ToolCall,
    /// A tool's finished result (success).
    ToolResult,
    /// A failed tool result.
    ToolResultFailure,
}

/// The near-black background shared by the entire tool call / result group, so a
/// proposed call and its result read together. Set just above pure black so it
/// forms a subtle box against the dark terminal without dulling the coloured text
/// that distinguishes those lines.
const TOOL_BACKGROUND: Color = Color::Rgb(18, 18, 20);

/// A subtle, low-intensity background for one [`Section`], tuned for a dark
/// terminal. Each tint is intentionally dark so it complements (rather than
/// competes with) the existing foreground colour coding, and it fills the full
/// inner width of the transcript box (excluding the box's own borders) because it
/// rides the per-line style the bordered paragraph paints across every column the
/// line occupies. Callers combine it with the section's existing foreground via
/// [`Style::patch`], which keeps the foreground colour and modifiers while filling
/// in only the background.
fn section_background(section: Section) -> Style {
    let tint = match section {
        Section::Prompt => Color::Rgb(46, 50, 64),
        Section::Reasoning => Color::Rgb(34, 34, 38),
        // Tool call / result group: one near-black so they're kept together;
        // their meaning comes from the foreground colour (blue / green / red).
        Section::ToolCall
        | Section::ToolResult
        | Section::ToolResultFailure => TOOL_BACKGROUND,
    };
    Style::default().bg(tint)
}
```

