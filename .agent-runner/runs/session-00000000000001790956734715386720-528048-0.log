impl Section {
    /// The shared, near-black background used by tool calls and tool results.
    /// Grouping them under one neutral tint keeps a proposed call visually
    /// attached to its result; the two are told apart by text colour alone, so
    /// this never competes with the green/red that marks success and failure.
    const TOOL_BACKGROUND: Color = Color::Rgb(30, 30, 31);

