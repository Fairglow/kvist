```rust
fn copy_vendor_file(src: &Path, dst: &Path, expected: u64, preparation) -> Result<()> {
    let input = file(src, MAX_FILE_BYTES)?;
    let output = OpenOptions::new().write(true).create_new(true).mode(0o400)
        .open(dst).map_err(...)?;
    let mut copied = 0_u64;
    loop {
        preparation.check()?;
        if copied >= expected { break; }
        let remaining = expected - copied;
        // copy_file_range transfers up to a bounded chunk from each file's
        // current offset, advancing both.
        let chunk = remaining.min(1 << 30) as usize;
        match nix::fcntl::copy_file_range(&input, None, &output, None, chunk) {
            Ok(n) if n > 0 => copied += n as u64,
            Ok(_) => break,
            Err(nix::errno::Errno::ENOSYS) => {
                // Kernel lacks copy_file_range; fall back to a bounded userspace copy.
                let n = userspace_copy(&input, &output, remaining, preparation)?;
                copied += n;
            }
            Err(e) => return Err(io_error("copy vendor snapshot file", Some(&src.to_string_lossy()), e)),
        }
    }
    let actual = output.metadata().map_err(...)?.len();
    if actual != expected {
        return Err(failure("vendor snapshot copy size mismatch"));
    }
    Ok(())
}

fn userspace_copy(input: &File, output: &File, remaining: u64, preparation) -> Result<u64> {
    let mut buffer = [0u8; 1 << 20];
    let mut copied = 0_u64;
    while copied < remaining {
        preparation.check()?;
        let want = (remaining - copied).min(buffer.len() as u64) as usize;
        let n = input.read(&mut buffer[..want]).map_err(...)?;
        if n == 0 { break; }
        output.write_all(&buffer[..n]).map_err(...)?;
        copied += n as u64;
    }
    Ok(copied)
}
```

