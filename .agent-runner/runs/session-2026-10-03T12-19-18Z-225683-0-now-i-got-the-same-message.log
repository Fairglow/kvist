And add `copy_snapshot_file`:
```rust
#[cfg(linux_android)]
fn copy_snapshot_file(
    input: &File,
    output: &File,
    expected: u64,
    preparation: &Preparation<'_>,
) -> Result<()> {
    // Kernel-side copy; the input fd is left at EOF after the hash pass, so we
    // start from explicit offsets. If the filesystem reports no progress
    // (unsupported), fall back to a user-space copy.
    let mut copied = 0_u64;
    let mut off_in = 0_i64;
    let mut off_out = 0_i64;
    let mut user_space = false;
    loop {
        preparation.check()?;
        let remaining = (expected - copied) as usize;
        if remaining == 0 { break; }
        let n = nix::fcntl::copy_file_range(input, Some(&mut off_in), output, Some(&mut off_out), remaining)
            .map_err(|e| io_error("kernel vendor snapshot copy", None, e))?;
        if n == 0 {
            if copied == 0 { user_space = true; }
            else { return Err(failure("vendor snapshot copy stalled")); }
            break;
        }
        copied += n as u64;
    }
    if user_space {
        user_space_copy(input, output, expected, preparation)
    } else {
        Ok(())
    }
}

#[cfg(not(linux_android))]
fn copy_snapshot_file(
    input: &File,
    output: &File,
    expected: u64,
    preparation: &Preparation<'_>,
) -> Result<()> {
    user_space_copy(input, output, expected, preparation)
}

fn user_space_copy(
    input: &File,
    output: &mut File,
    expected: u64,
    preparation: &Preparation<'_>,
) -> Result<()> {
    use std::io::Seek, std::io::SeekFrom;
    input.seek(SeekFrom::Start(0)).map_err(|e| io_error("rewind vendor snapshot input", None, e))?;
    let mut copied = 0_u64;
    let mut buffer = [0_u8; 65536];
    loop {
        preparation.check()?;
        let n = input.read(&mut buffer).map_err(|e| io_error("read local vendor snapshot", None, e))?;
        if n == 0 { break; }
        output.write_all(&buffer[..n]).map_err(|e| io_error("write private vendor snapshot", None, e))?;
        copied += n as u64;
        if copied > expected {
            return Err(failure("vendor snapshot grew beyond its bounded size"));
        }
    }
    Ok(())
}
