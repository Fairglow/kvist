use std::io::Seek; // not needed

/// Copies `limit` bytes at most from `input` to `output` using the kernel's
/// `copy_file_range(2)`, which can perform same-filesystem copies
/// (ext4/Btrfs/XFS reflinks) almost instantly. Unlike a userspace read/write
/// loop, it avoids copying the entire vendor tree through the process on every startup.
/// Stops early if the input ends before `limit`.
///
/// Returns the number of bytes actually copied.
fn copy_file_range_bytes(
    input: &mut File,
    output: &mut File,
    limit: u64,
    preparation: &Preparation<'_>,
) -> Result<u64> {
    use nix::libc::c_int;
    let mut copied = 0_u64;
    let mut offset_in = 0_u64;
    let mut offset_out = 0_u64;
    while copied < limit {
        preparation.check()?;
        let mut off_in = offset_in as i64;
        let mut off_out = offset_out as i64;
        let remaining = (limit - copied) as i64;
        let result = unsafe {
            nix::libc::copy_file_range(
                input.as_raw_fd(),
                &mut off_in,
                output.as_raw_fd(),
                &mut off_out,
                remaining as usize,
                0,
            )
        };
        let n = if result < 0 {
            let err = std::io::Error::last_os_error();
            return Err(io_error("copy vendor snapshot file", None, err));
        } else {
            result
        };
        if n == 0 {
            break;
        }
        copied += n as u64;
        offset_in += n as u64;
        offset_out += n as u64;
    }
    Ok(copied)
}
```

Note: `as_raw_fd` requires importing `std::os::fd::AsFd`. The crate already imports `std::os::unix::fs::*`. `AsFd` is in `std::os::fd::AsFd`.

