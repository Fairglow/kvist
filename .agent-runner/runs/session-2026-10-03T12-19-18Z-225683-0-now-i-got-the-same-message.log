/// Copy the enumerated vendor files to the private snapshot in parallel,
/// re-verifying each source fingerprint after the copy.
fn copy_files_parallel(
    files: &[(PathBuf, Vec<u8>, u64)],
    source_root: &Path,
    destination: &Path,
    preparation: &Preparation<'_>,
) -> Result<()> {
    let workers = std::thread::available_parallelism()
        .map(|n| n.get())
        .unwrap_or(1)
        .min(8);
    if files.is_empty() {
        return Ok(());
    }
    let chunk = (files.len() + workers - 1) / workers;
    let mut jobs = Vec::new();
    for part in files.chunks(chunk) {
        let part: Vec<(PathBuf, Vec<u8>, u64)> = part.to_vec();
        jobs.push(part);
    }
    std::thread::scope(|scope| {
        let handles = jobs
            .into_iter()
            .map(|part| {
                scope.spawn(move || {
                    for (src, relative, size) in &part {
                        preparation.check()?;
                        let dst = destination.join(Path::new(relative));
                        snapshot_copy(src, dst, *size, preparation)?;
                        // Catch source drift during the copy. The identity and
                        // size were recorded before the copy.
                        let after = inspect_path(src)?;
                        // Compare against what? Need a pre-fingerprint...
                    }
                    Ok(())
                })
            })
            .collect::<Vec<_>>();
        for handle in handles {
            handle.join().map_err(|_| failure("vendor snapshot worker panicked"))?;
        }
        Ok(())
    })?
}
```

