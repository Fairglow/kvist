/// Copies a single regular, non-link file into a private snapshot.
///
/// Prefers a same-filesystem reflink (independent, O(1) on supported
/// storage), then a hard link, then a bounded byte copy. This keeps large
/// vendor registries cheap to snapshot without paying the cost of a full
/// read/write. The destination is created fresh and read-only, and its bytes
/// are never written after creation; the sandbox mount is read-only so it
/// cannot mutate the shared bytes.
fn snapshot_copy(src: &Path, dst: &Path, size: u64, preparation: &Preparation<'_>) -> Result<()> {
    let input = file(src, MAX_FILE_BYTES)?;

    // 1) Reflink: a private, independent clone on supporting storage.
    if reflink_copy(&input, dst, size, preparation).is_ok() {
        return Ok(());
    }
    let _ = fs::remove_file(dst);

    // 2) Hard link: shares the source inode; safe because the sandbox grant is
    //    read-only and the snapshot destination is never written after creation.
    if fs::hard_link(src, dst).is_ok() {
        let _ = fs::set_permissions(dst, fs::Permissions::from_mode(0o400));
        return Ok(());
    }

    // 3) Bounded byte-copy fallback.
    byte_copy(&input, dst, size, preparation)
}
```

