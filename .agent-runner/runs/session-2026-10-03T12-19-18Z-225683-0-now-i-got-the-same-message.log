pub(crate) fn check_cancelled(cancellation: &CancellationToken) -> Result<()> {
    if cancellation.is_cancelled() {
        Err(Error::SandboxExec {
            tool: None,
            reason: "cancelled before staging or process execution".to_owned(),
        })
    } else {
        Ok(())
    }
}

