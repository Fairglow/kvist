#[test]
fn snapshot_identity_binds_paths_and_sizes_and_clone_is_read_only() {
    let directory = fixture();
    let source = directory.path().join("vendor");
    fs::create_dir(&source).unwrap();
    fs::create_dir(source.join("crate-a")).unwrap();
    fs::write(source.join("crate-a/file"), b"initial").unwrap();
    let source = source.canonicalize().unwrap();
    let cancellation = CancellationToken::new();
    let preparation = Preparation { started: Instant::now(), cancellation: &cancellation };
    let first = snapshot_vendor(&source, &directory.path().join("copy1"), &preparation).unwrap();
    fs::rename(source.join("crate-a"), source.join("crate-b")).unwrap();
    let second = snapshot_vendor(&source, &directory.path().join("copy2"), &preparation).unwrap();
    assert_ne!(first, second);
    // Replace-style update: the previous inode (and its snapshot clone) is left alone.
    fs::write(source.join("crate-b/file.new"), b"replacement").unwrap();
    fs::rename(source.join("crate-b/file.new"), source.join("crate-b/file")).unwrap();
    let third = snapshot_vendor(&source, &directory.path().join("copy3"), &preparation).unwrap();
    assert_ne!(second, third);
    assert_eq!(fs::read(directory.path().join("copy1/crate-b/file")).unwrap(), b"initial");
    // Snapshots are private read-only views: the clone cannot be written to.
    let clone = directory.path().join("copy1/crate-b/file");
    assert!(OpenOptions::new().write(true).open(&clone).is_err());
}
```

