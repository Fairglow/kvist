    let mut user_space = false;
    'outer: while copied < expected {
        preparation.check()?;
        let chunk = (expected - copied).min(64 << 20) as usize;
        match nix::fcntl::copy_file_range(input, None, output, None, chunk) {
            Ok(0) => break 'outer,
            Ok(advanced) => copied += advanced as u64,
            Err(e) if e.kind() == std::io::ErrorKind::CrossesDevices => user_space = true,
            Err(e) => return Err(io_error("copy local vendor snapshot", None, e)),
        }
        if user_space { break 'outer; }
    }
    if user_space {
