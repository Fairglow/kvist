```rust
fn byte_copy(input: &File, dst: &Path, size: u64, preparation: &Preparation<'_>) -> Result<()> {
    let mut out = OpenOptions::new()
        .write(true)
        .create_new(true)
        .mode(0o400)
        .open(dst)
        .map_err(|e| io_error("create private vendor snapshot file", None, e))?;
    let mut copied = 0_u64;
    let mut buffer = [0u8; 65536];
    while copied < size {
        preparation.check()?;
        let len = std::cmp::min((size - copied) as usize, buffer.len());
        let n = input
            .read(&mut buffer[..len])
            .map_err(|e| io_error("read local vendor snapshot", None, e))?;
        if n == 0 {
            let _ = fs::remove_file(dst);
            return Err(failure(
                "vendor source shrank while snapshotting; refresh on the host and restart",
            ));
        }
        out.write_all(&buffer[..n])
            .map_err(|e| io_error("write private vendor snapshot", None, e))?;
        copied += n as u64;
    }
    let dest = out
        .metadata()
        .map_err(|e| io_error("inspect vendor snapshot output", None, e))?;
    if dest.len() != size {
        let _ = fs::remove_file(dst);
        return Err(failure("vendor snapshot file length mismatch"));
    }
    Ok(())
}
```

