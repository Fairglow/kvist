    source: &Path,
    destination: &Path,
    preparation: &Preparation<'_>,
) -> Result<String> {
    // Phase one: enumerate and bind the source tree. The identity is the
    // stable order of relative paths and sizes; file bytes are carried into
    // the private snapshot by the copy phase, never re-read for identity.
    let source_root = source.to_owned();
    let mut stack = vec![(source.to_owned(), destination.to_owned(), 0_usize)];
    let mut count = 0_usize;
    let mut total = 0_u64;
    let mut identity = Sha256::new();
    let mut directories = Vec::new();
    let mut files: Vec<(PathBuf, PathBuf, u64, Fingerprint)> = Vec::new();
    let mut path_bytes = 0_usize;
    while let Some((source, destination, depth)) = stack.pop() {
        preparation.check()?;
        let directory = inspect_path(&source)?;
        if depth > 64 || !directory.is_dir() {
            return Err(failure(
                "vendor resource must be a non-link directory tree of depth at most 64",
            ));
        }
        directories.push((source.clone(), fingerprint(&directory)));
        fs::create_dir(&destination)
            .map_err(|e| io_error("create private vendor snapshot directory", None, e))?;
        let mut entries = Vec::new();
        for entry in
            fs::read_dir(&source).map_err(|e| io_error("read local vendored registry", None, e))?
        {
            preparation.check()?;
            count += 1;
            if count > MAX_ENTRIES {
                return Err(failure("vendored registry exceeds 100000 snapshot entries"));
            }
            let entry =
                entry.map_err(|e| io_error("enumerate local vendored registry", None, e))?;
            path_bytes =
                path_bytes.saturating_add(entry.path().as_os_str().len().saturating_mul(3));
            if path_bytes > 32 << 20 {
                return Err(failure(
                    "vendor snapshot exceeds its 32 MiB retained-path bound",
                ));
            }
            entries.push(entry);
        }
        entries.sort_by_key(|entry| entry.file_name());
        for entry in entries {
            preparation.check()?;
            let src = entry.path();
            let dst = destination.join(entry.file_name());
            let metadata = inspect_path(&src)?;
            if metadata.is_dir() {
                stack.push((src, dst, depth + 1));
                continue;
            }
            if !metadata.is_file() || metadata.nlink() != 1 {
                return Err(failure(
                    "vendored registry must contain only regular single-link files/directories, not links, hard links or special entries",
                ));
            }
            let size = metadata.len();
            if size > MAX_FILE_BYTES || total + size > MAX_VENDOR_BYTES {
                return Err(failure(
                    "vendor snapshot exceeds 256 MiB/file or 1 GiB aggregate",
                ));
            }
            total += size;
            let relative = src
                .strip_prefix(&source_root)
                .map_err(|_| failure("invalid vendor entry"))?
                .as_os_str()
                .as_encoded_bytes();
            identity.update((relative.len() as u64).to_be_bytes());
            identity.update(relative);
            identity.update(size.to_be_bytes());
            files.push((src, dst, size, fingerprint(&metadata)));
        }
    }

    // Phase two: copy the collected files across a bounded thread pool so a
    // large registry does not pay one full sequential read/write. Each worker
    // re-checks its own source fingerprint after copying, and a final pass
    // re-checks every source so a registry that changed while the snapshot was
    // taken fails as a whole.
    let (tx, rx) = std::sync::mpsc::channel::<std::result::Result<(), Error>>();
    let pool = std::cmp::min(files.len(), 8).max(1);
    let chunk = std::cmp::max(files.len() / pool, 1);
    let mut handles = Vec::new();
    for group in files.chunks(chunk) {
        let tx = tx.clone();
        handles.push(std::thread::spawn(move || {
            for (src, dst, size, before) in group {
                let result = (|| -> Result<()> {
                    preparation.check()?;
                    snapshot_copy(src, dst, *size, preparation)?;
                    if fingerprint(&inspect_path(src)?) != *before {
                        let _ = fs::remove_file(dst);
                        Err(failure(
                            "vendored file changed while snapshotting; refresh on the host and restart",
                        ))
                    } else {
                        Ok(())
                    }
                })();
                tx.send(result).ok();
            }
        }));
    }
    drop(tx);
    for handle in handles {
        handle
            .join()
            .map_err(|_| failure("vendor snapshot worker panicked"))?;
    }
    for result in rx {
        result?;
    }

    for (path, before) in directories {
        preparation.check()?;
        if fingerprint(&inspect_path(&path)?) != before {
            return Err(failure(
                "vendor directory changed while snapshotting; refresh on the host and restart",
            ));
        }
    }
    for (path, _, _, before) in &files {
        preparation.check()?;
        if fingerprint(&inspect_path(path)?) != *before {
            return Err(failure(
                "vendored file changed while snapshotting; refresh on the host and restart",
            ));
        }
    }
    Ok(format!("sha256:{}", hex::encode(identity.finalize())))
}

/// Copies one regular, non-link file into the private snapshot.
///
/// Prefers a same-filesystem reflink (an independent, O(1) clone on supporting
/// storage) and falls back to a bounded byte copy, so a large vendor registry
/// snapshots without paying a full read/write on btrfs/XFS. The destination is
/// created fresh and read-only; only the private destination bytes are ever
/// written. A hard link is deliberately not used: the workspace is writable, so
/// a shared inode would let a workspace write mutate the snapshot.
fn snapshot_copy(
    src: &Path,
    dst: &Path,
    size: u64,
    preparation: &Preparation<'_>,
) -> Result<()> {
    let input = file(src, MAX_FILE_BYTES)?;
    if reflink_copy(&input, dst, size, preparation).is_ok() {
        return Ok(());
    }
    let _ = fs::remove_file(dst);
    byte_copy(&input, dst, size, preparation)
}

fn reflink_copy(
    input: &File,
    dst: &Path,
    size: u64,
    preparation: &Preparation<'_>,
) -> std::io::Result<()> {
    let out = OpenOptions::new()
        .write(true)
        .create_new(true)
        .mode(0o400)
        .open(dst)?;
    let mut copied = 0_u64;
    let mut in_off: i64 = 0;
    let mut out_off: i64 = 0;
    while copied < size {
        preparation
            .check()
            .map_err(|_| {
                std::io::Error::new(
                    std::io::ErrorKind::Other,
                    "vendor snapshot preparation cancelled or over budget",
                )
            })?;
        let len = std::cmp::min((size - copied) as usize, 1usize << 30);
        let n = nix::fcntl::copy_file_range(
            input.as_fd(),
            Some(&mut in_off),
            out.as_fd(),
            Some(&mut out_off),
            len,
        )?;
        if n == 0 {
            break;
        }
        copied += n as u64;
    }
    if copied != size {
        return Err(std::io::Error::new(
            std::io::ErrorKind::Other,
            "reflink copy was partial",
        ));
    }
    Ok(())
}

fn byte_copy(
    input: &File,
    dst: &Path,
    size: u64,
    preparation: &Preparation<'_>,
) -> Result<()> {
    let mut out = OpenOptions::new()
        .write(true)
        .create_new(true)
        .mode(0o400)

