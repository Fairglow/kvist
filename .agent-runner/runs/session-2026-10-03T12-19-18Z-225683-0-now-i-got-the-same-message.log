```rust
pub fn resolve_for_workspace(
    policy: ToolPolicy,
    settings: &BTreeMap<ToolProfile, ProfileSetting>,
    probe: &dyn ToolchainProbe,
    forced: Option<ToolProfile>,
    workdir: &std::path::Path,
) -> crate::error::Result<Self> {
    let setting = ...same...;
    let mut settings_without_rust = ...same...;
    let mut registry = Self::resolve(...)?;
    if setting != ProfileSetting::Off {
        let workdir = workdir.to_owned();
        let cancellation = agent_runtime::CancellationToken::new();
        let thread = std::thread::Builder::new()
            .name("rust-resource-resolution".into())
            .spawn(move || crate::toolchain::rust_environment::RustEnvironment::resolve(&workdir))
            .map_err(|e| crate::error::Error::Io {
                operation: "spawn Rust resource resolution".into(),
                path: None,
                source: std::io::Error::other(format!("...")),
            })?;
        let deadline = std::time::Instant::now() + crate::toolchain::rust_environment::PREPARATION_DEADLINE;
        let result = loop {
            match thread.try_join() {
                Ok(resolved) => break resolved,
                Err(std::thread::panics::Panic) => {
                    cancellation.cancel();
                    let _ = thread.join();
                    return Err(crate::error::Error::SandboxBuild { reason: "Rust resource resolution panicked".into() });
                }
                Err(std::thread::panics::Panic) ...
                Err(std::thread::panics::Panic) => ...
                Err(std::thread::panics::Panic) => ...
                Err(std::thread::panics::Panic) => ...
                _ => {
                    if std::time::Instant::now() >= deadline {
                        cancellation.cancel();
                        let _ = thread.join();
                        return Err(crate::error::Error::SandboxBuild {
                            reason: format!(
                                "Rust resource resolution is still running after {} seconds; ..."
                            ),
                        });
                    }
                    std::thread::sleep(std::time::Duration::from_millis(25));
                }
            }
        };
        match result {
            Ok(environment) => { ...same... }
            Err(error) if setting == ProfileSetting::Auto => { ...same... }
            Err(error) => return Err(error),
        }
    }
    Ok(registry)
}
```

