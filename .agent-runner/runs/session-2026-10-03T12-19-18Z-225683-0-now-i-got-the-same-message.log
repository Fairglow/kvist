/// The size of a snapshot destination, which must exist as a regular file.
fn dest_size(path: &Path) -> Result<u64> {
    let metadata = inspect_path(path)?;
    if !metadata.is_file() {
        return Err(failure("vendor snapshot destination must be a regular file"));
    }
    Ok(metadata.len())
}

/// Copies one regular, non-link file into the private snapshot.
///
/// Prefers a same-filesystem reflink (independent, O(1) on supporting storage),
/// then a hard link, then a bounded byte copy, so a large vendor registry
/// snapshots without paying a full read/write. The destination is created
/// fresh and read-only; only the private destination bytes are ever written.
fn snapshot_copy(
    src: &Path,
    dst: &Path,
    size: u64,
    preparation: &Preparation<'_>,
) -> Result<()> {
    let input = file(src, MAX_FILE_BYTES)?;

    // 1) Reflink: a private, independent clone on supporting storage.
    if reflink_copy(&input, dst, size, preparation).is_ok() {
        return Ok(());
    }
    let _ = fs::remove_file(dst);

    // 2) Hard link: shares the source inode. Safe because the sandbox grant is
    //    read-only (the model cannot mutate the bytes) and the private
    //    destination is never written after creation.
    if fs::hard_link(src, dst).is_ok() {
        let _ = fs::set_permissions(dst, fs::Permissions::from_mode(0o400));
        return Ok(());
    }

    // 3) Bounded byte-copy fallback.
    byte_copy(&input, dst, size, preparation)
}

fn reflink_copy(
    input: &File,
    dst: &Path,
    size: u64,
    preparation: &Preparation<'_>,
) -> std::io::Result<()> {
    let out = OpenOptions::new()
        .write(true)
        .create_new(true)
        .mode(0o400)
        .open(dst)?;
    let mut copied = 0_u64;
    let mut in_off: i64 = 0;
    let mut out_off: i64 = 0;
    while copied < size {
        preparation
            .check()
            .map_err(|_| {
                std::io::Error::new(
                    std::io::ErrorKind::Other,
                    "vendor snapshot preparation cancelled or over budget",
                )
            })?;
        let len = std::cmp::min((size - copied) as usize, 1usize << 30);
        let n = nix::fcntl::copy_file_range(
            input.as_fd(),
            Some(&mut in_off),
            out.as_fd(),
            Some(&mut out_off),
            len,
        )?;
        if n == 0 {
            break;
        }
        copied += n as u64;
    }
    if copied != size {
        return Err(std::io::Error::new(
            std::io::ErrorKind::Other,
            "reflink copy was partial",
        ));
    }
    Ok(())
}

fn byte_copy(
    input: &File,
    dst: &Path,
    size: u64,
    preparation: &Preparation<'_>,
) -> Result<()> {
    let mut out = OpenOptions::new()
        .write(true)
        .create_new(true)
        .mode(0o400)
        .open(dst)
        .map_err(|e| io_error("create private vendor snapshot file", None, e))?;
    let mut copied = 0_u64;
    let mut buffer = [0u8; 65536];
    while copied < size {
        preparation.check()?;
        let len = std::cmp::min((size - copied) as usize, buffer.len());
        let n = input
            .read(&mut buffer[..len])
            .map_err(|e| io_error("read local vendor snapshot", None, e))?;
        if n == 0 {
            let _ = fs::remove_file(dst);
            return Err(failure(
                "vendor source shrank while snapshotting; refresh on the host and restart",
            ));
        }
        out.write_all(&buffer[..n])
            .map_err(|e| io_error("write private vendor snapshot", None, e))?;
        copied += n as u64;
    }
    let dest = out
        .metadata()
        .map_err(|e| io_error("inspect vendor snapshot output", None, e))?;
    if dest.len() != size {
        let _ = fs::remove_file(dst);
        return Err(failure("vendor snapshot file length mismatch"));
    }
    Ok(())
}

