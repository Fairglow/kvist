and add a helper:

```rust
/// Hashes the collected executables across a bounded thread pool so toolchain
/// resolution does not pay one sequential read of every compiler binary.
fn hash_executables(
    paths: &[PathBuf],
    preparation: &Preparation<'_>,
) -> Result<Vec<(PathBuf, String)>> {
    if paths.is_empty() {
        return Ok(Vec::new());
    }
    let pool = std::cmp::min(paths.len(), 8).max(1);
    let chunk = std::cmp::max(paths.len() / pool, 1);
    let (tx, rx) = std::sync::mpsc::channel::<std::result::Result<(usize, PathBuf, String), Error>>();
    let mut handles = Vec::new();
    for (start, group) in paths.chunks(chunk).enumerate() {
        let tx = tx.clone();
        let base = start * chunk;
        handles.push(std::thread::spawn(move || {
            for (offset, path) in group.iter().enumerate() {
                let result = (|| -> Result<_> {
                    preparation.check()?;
                    Ok((base + offset, path.clone(), hash_file(path, preparation)?))
                })();
                tx.send(result).ok();
            }
        }));
    }
    drop(tx);
    for handle in handles {
        handle
            .join()
            .map_err(|_| failure("executable hash worker panicked"))?;
    }
    let mut collected = Vec::with_capacity(paths.len());
    for result in rx {
        collected.push(result?);
    }
    collected.sort_by_key(|(index, _, _)| *index);
    Ok(collected.into_iter().map(|(_, path, digest)| (path, digest)).collect())
}
```

