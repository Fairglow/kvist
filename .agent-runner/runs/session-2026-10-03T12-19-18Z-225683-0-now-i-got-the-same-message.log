+/// Hashes the collected toolchain executables across a bounded thread pool so
+/// the large `rustc`/`std` binaries do not dominate the preparation budget
+/// sequentially. Results are returned in the exact input order so the derived
+/// identity stays stable and deterministic.
+fn hash_executables(
+    paths: &[PathBuf],
+    preparation: &Preparation<'_>,
+) -> Result<Vec<(PathBuf, String)>> {
+    if paths.is_empty() {
+        return Ok(Vec::new());
+    }
+    let pool = std::cmp::min(paths.len(), 8).max(1);
+    let chunk = std::cmp::max(paths.len() / pool, 1);
+    let (tx, rx) = std::sync::mpsc::channel::<std::result::Result<(usize, PathBuf, String), Error>>();
+    std::thread::scope(|scope| {
+        for (offset, group) in paths.chunks(chunk).enumerate() {
+            let tx = tx.clone();
+            scope.spawn(|| {
+                for (index, path) in group.iter().enumerate() {
+                    let position = offset * chunk + index;
+                    let result = hash_file(path, preparation)
+                        .map(|hash| (position, path.clone(), hash));
+                    tx.send(result).ok();
+                }
+            });
+        }
+    });
+    let mut results: Vec<Option<(PathBuf, String)>> = vec![None; paths.len()];
+    for result in rx {
+        let (position, path, hash) = result?;
+        results[position] = Some((path, hash));
+    }
+    Ok(results
+        .into_iter()
+        .map(|entry| entry.expect("hash result present for every path"))
+        .collect())
+}
