Let me refine `resolve_rustup_toolchain_root()`:

```rust
/// Locate the Rust toolchain root `rustup` should treat as active when the
/// installed toolchain tree was not registered with rustup (rustup reports
/// "no installed toolchains" and refuses to run any subcommand).
///
/// `rustup` normally discovers the active toolchain from its own registry, but
/// a host can ship the toolchain as a bare tree without a rustup registration,
/// in which case `rustup which cargo` fails even though `cargo` and `rustc`
/// run fine directly. Setting `RUSTUP_TOOLCHAIN` points rustup at a real
/// toolchain root without installing anything or touching rustup's registry.
///
/// Resolution, in order:
///   1. an explicit `RUSTUP_TOOLCHAIN` the environment already provides (if
///      it names a complete toolchain root);
///   2. the first `cargo` on `PATH`, canonicalized and validated as a
///      complete toolchain root (the host's active toolchain);
///   3. the conventional host location `/rust/toolchain`.
///
/// Returns `None` when nothing valid is found, so rustup's normal resolution
/// still applies and nothing is forced.
pub(crate) fn resolve_rustup_toolchain_root() -> Option<PathBuf> {
    if let Some(explicit) = std::env::var_os("RUSTUP_TOOLCHAIN") {
        if let Ok(root) = cargo_toolchain_from_path(&explicit, "rustup") {
            return Some(root.toolchain_root);
        }
    }
    // Walk PATH for a cargo/rustc and derive the toolchain root from it.
    let path_value = std::env::var("PATH").unwrap_or_default();
    for dir in path_value.split(':').filter(|d| !d.is_empty()) {
        for name in ["cargo", "rustc"] {
            if let Some(path) = std::path::Path::new(dir).join(name).canonicalize().ok() {
                if let Ok(resolved) = cargo_toolchain_from_path(
                    &path.to_string_lossy(),
                    "rustup",
                ) {
                    return Some(resolved.toolchain_root);
                }
            }
        }
    }
    if let Ok(root) = cargo_toolchain_from_path("/rust/toolchain/bin/cargo", "rustup") {
        return Some(root.toolchain_root);
    }
    None
}
```

