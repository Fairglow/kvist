```rust
fn rustup_toolchain_root() -> Option<PathBuf> {
    let path_value = std::env::var("PATH").unwrap_or_else(|_| SANDBOX_PATH-ish);
    for dir in path_value.split(':') {
        if dir.is_empty() { continue; }
        let candidate = PathBuf::from(dir).join("cargo");
        let canonical = candidate.canonicalize().ok()?;
        if let (Some(bin), Some(root)) = (canonical.parent(), canonical.parent().and_then(|p| p.parent())) {
            // bin = .../bin, root = .../toolchain
            let root = root;
            if root.join("lib").join("rustlib").is_dir() || root.join("rustlib").is_dir() {
                return Some(root.to_path_buf());
            }
        }
    }
    None
}
```

