pub fn resolve_cargo_toolchain(runner: &str) -> Result<ResolvedCargoToolchain> {
    let mut child = std::process::Command::new("rustup").args(["which", "cargo"]);
    // Use the provisioned toolchain directly and never reach for the network:
    // `RUSTUP_TOOLCHAIN` selects the already-installed tree as the active
    // toolchain; `RUSTUP_OFFLINE` fails closed instead of attempting a download.
    child.env("RUSTUP_TOOLCHAIN", "/rust/toolchain");
    child.env("RUSTUP_OFFLINE", "true");
    let output = child
        .output()
        .map_err(|source| KvistError::SandboxUnavailable {
            runner: runner.to_owned(),
            reason: format!("cannot invoke rustup to locate the Rust toolchain: {source}"),
        })?;
```

