```rust
/// The environment variable that pins `rustup` to a host-provisioned toolchain
/// tree that has never been registered with `rustup`.
const RUSTUP_TOOLCHAIN_ENV: &str = "RUSTUP_TOOLCHAIN";

/// Discover the host-provisioned Rust toolchain root from `PATH`.
///
/// The host installs the Rust toolchain as a complete tree (a directory whose
/// `bin/` holds `cargo`, `rustc`, and `rustlib`) but never registers it with
/// `rustup`, so a bare `rustup which cargo` refuses to run ("no default is
/// configured"). rustup can address such a tree directly via the
/// `RUSTUP_TOOLCHAIN` environment variable, which we discover here and expose
/// to the `rustup` invocation without hardcoding any host path.
fn discover_host_rust_toolchain_root() -> Option<PathBuf> {
    let path_value = std::env::var("PATH").ok()?;
    for entry in std::env::split_paths(&path_value) {
        // A toolchain `bin/` lives one level below the toolchain root; its
        // parent is the root. System `bin/` directories (e.g. `/usr/bin`)
        // are rejected because their parent is not a toolchain root.
        if entry.file_name().and_then(|name| name.to_str()) == Some("bin") {
            if let Some(root) = entry.parent() {
                if is_valid_toolchain_root(root) {
                    return Some(root.to_path_buf());
                }
            }
        }
    }
    None
}

/// Whether `root` is a complete Rust toolchain tree: it must contain the
/// toolchain `bin/` with a `rustc` and `rustlib/`.
fn is_valid_toolchain_root(root: &Path) -> bool {
    root.join("bin").join("rustc").is_file()
        && root.join("bin").join("rustlib").is_dir()
}
```

