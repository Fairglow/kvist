/// Discover a Rust toolchain root from the host `PATH`.
///
/// `rustup` refuses to run any subcommand — including the bare
/// `rustup which cargo` this function runs — when no default toolchain is
/// configured and nothing is installed. The host-provisioned toolchain tree
/// (e.g. `/rust/toolchain`) sidesteps that: it is a complete, real toolchain
/// set that rustup can address directly via `RUSTUP_TOOLCHAIN` without ever
/// being registered. We find that tree by locating the `bin` directory on
/// `PATH` whose parent holds a `rustc` — the definitive marker of a Rust
/// toolchain — and point `RUSTUP_TOOLCHAIN` there.
fn discover_rust_toolchain_root() -> Option<PathBuf> {
    let path_value = std::env::var("PATH").ok()?;
