```rust
/// Build a rustup invocation pre-configured to use the host-provisioned,
/// network-denied toolchain without depending on a rustup-registered default.
///
/// `RUSTUP_TOOLCHAIN` points rustup at the real toolchain tree on PATH so a
/// `rustup which cargo` resolves even when no channel is registered with
/// rustup; `RUSTUP_OFFLINE` makes rustup fail closed instead of reaching for
/// the network; the ambient `CARGO_HOME`/`PATH` (injected by the sandbox host)
/// are preserved so the resolved binary and its runtime are reachable.
fn rustup_command() -> std::process::Command {
    let mut command = std::process::Command::new("rustup");
    if let Some(root) = rustup_toolchain_root() {
        command.env("RUSTUP_TOOLCHAIN", root);
    }
    command.env("RUSTUP_OFFLINE", "true");
    command
}

/// Discover the rustup toolchain tree hosting `cargo` on `PATH` so the toolchain
/// can be named explicitly for rustup. `rustup` needs a complete toolchain root
/// (with a `rustlib` runtime) to resolve cargo itself; deriving it from the
/// `cargo` on `PATH` avoids the chicken-and-egg of asking rustup for its location.
fn rustup_toolchain_root() -> Option<PathBuf> {
    let path_value = std::env::var("PATH").unwrap_or_default();
    let cargo = path_value
        .split(std::path::Path::SEPARATOR)
        .filter(|dir| !dir.is_empty())
        .filter_map(|dir| dir.join("cargo").to_path_buf().canonicalize().ok())
        .find_map(|candidate| cargo_toolchain_from_path(&candidate.to_string_lossy(), "<rustup>").ok())
        .map(|resolved| resolved.root);
    cargo
}
```

