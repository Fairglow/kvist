```rust
fn render_transcript(f: &mut ratatui::Frame, app: &App, area: Rect) {
    // The box keeps a top and right frame (no left frame), with a one‑column
    // color gutter on the left so the content width matches the header/stats
    // (which have no left border). The gutter column is rendered separately
    // with the row background, so it never overlaps the content.
    let block_area = Rect::new(area.left() + GUTTER_WIDTH, area.top(), area.width.saturating_sub(GUTTER_WIDTH as u16).max(1), area.height);
    let inner_width = usize::from(area.width.saturating_sub(2).max(1));
    let lines: Vec<Line> = app
        .lines
        .iter()
        .map(|screen_line| full_width_line(&screen_line.line, screen_line.bg, inner_width))
        .collect();
    let block = Block::default()
        .borders(Borders::TOP | Borders::RIGHT)
        .title(Span::styled(
            format!(" transcript [{}] ", app.lines.len()),
            Style::default().fg(Color::DarkGray),
        ));
    let paragraph = Paragraph::new(Text::from(lines))
        .block(block)
        .scroll((app.scroll, 0));
    f.render_widget(paragraph, block_area);

    // Paint the gutter column for the visible height with each row's
    // background so the block reads as a continuous box across the gutter.
    // Rendered but never part of the copy payload.
    let viewport = area.height.saturating_sub(2).max(1);
    for y in 0..viewport {
        gutter_line(bg_for_row(y), area.left(), block_area.top() + y, f.buffer_mut());
    }
    ...
}
```

