Let me write the BorderMode enum and helper:

```rust
/// The right‑edge frame drawn alongside the transcript and prompt boxes.
/// Cycled with Ctrl+S so the same look can be compared at a glance:
/// a color gutter (clean — the gutter holds only background‑colored cells,
/// so a terminal copy grabs no frame), the classic scrollbar (▲/▼/│), or
/// no frame at all.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
pub enum BorderMode {
    /// A 1‑column background‑colored gutter on the right.
    #[default]
    Gutter,
    /// The classic scrollbar riding the right column.
    Scroll,
    /// No right frame.
    None,
}

impl BorderMode {
    /// Advance to the next frame style (Ctrl+S).
    fn cycle(self) -> Self {
        match self {
            BorderMode::Gutter => BorderMode::Scroll,
            BorderMode::Scroll => BorderMode::None,
            BorderMode::None => BorderMode::Gutter,
        }
    }
    /// Whether the frame occupies one column on the right (nothing when None).
    fn gutter_width(self) -> u16 {
        match self {
            BorderMode::None => 0,
            _ => 1,
        }
    }
}
```

