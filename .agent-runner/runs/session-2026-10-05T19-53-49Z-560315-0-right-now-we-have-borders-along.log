fn render_transcript(f, app, area) {
    let gutter = app.border_mode.gutter_width();
    let inner_width = usize::from(area.width.saturating_sub(gutter).max(1));
    let lines = app.lines.iter().map(|sl| full_width_line(&sl.line, sl.bg, inner_width)).collect();
    let block = Block::default().borders(Borders::TOP).title(...);
    let paragraph = Paragraph::new(Text::from(lines)).block(block).scroll((app.scroll, 0));
    f.render_widget(paragraph, area);
    // frame
    if !matches!(app.border_mode, BorderMode::None) {
        // draw frame at rightmost column, rows below top border
        let viewport = area.height.saturating_sub(1).max(1) as usize; // minus top border
        let content_length = app.lines.len().max(viewport);
        let offset = (app.scroll as usize).min(app.lines.len().saturating_sub(viewport));
        // scrollbar
        if matches!(app.border_mode, BorderMode::Scroll) {
            let mut state = ScrollbarState::new(content_length).position(offset).viewport_content_length(viewport);
            let bar_area = Rect::new(area.right()-1, area.top()+1, 1, area.height-1);
            f.render_stateful_widget(Scrollbar::new(VerticalRight)... , bar_area, &mut state);
        } else {
            // color gutter: fill the rightmost column below the top border with spaces + bg
            let gutter_area = Rect::new(area.right()-1, area.top()+1, 1, area.height-1);
            // draw a background-colored block (or plain cells)
            f.render_widget(Block::default().style(Style::default().bg(some_color)), gutter_area);
        }
    }
}
```

