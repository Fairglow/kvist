    #[test]
    fn eta_is_none_after_a_compaction_reset() {
        let mut app = app();
        let push = |app: &mut App, ctx: usize, elapsed: f64| {
            app.push_event(Event::Progress {
                input_tokens: 0,
                output_tokens: 0,
                context_tokens: ctx,
                context_limit: 8192,
                context_utilization: 0.5,
                compaction_progress: 0.4,
                tokens_per_sec: 50.0,
                total_tokens: 1024,
                elapsed_secs: elapsed,
            });
        };
        push(&mut app, 4000, 10.0);
