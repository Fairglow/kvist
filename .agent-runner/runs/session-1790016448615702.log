/// Minimal base64 decoder, matching [`base64_encode`], used by tests to assert
/// the exact content an OSC 52 clipboard escape would deliver.
///
/// The shift amount for the last byte is `bytes_kept * 8` from the top of the
/// 24-bit group, so a 2-char chunk (`XX==`, 1 byte) shifts 16, a 3-char chunk
/// (`XXX=`, 2 bytes) shifts 8, and a full chunk (3 bytes) shifts 0. Using a
/// fixed shift would corrupt every trailing chunk that is not a multiple of 3
/// bytes, which is exactly the case the OSC 52 escape can hit.
/// Minimal base64 decoder, matching [`base64_encode`], used by tests to assert
/// the exact content an OSC 52 clipboard escape would deliver.
///
/// Groups are decoded four characters at a time. A full group (4 chars) yields
/// 3 bytes; a trailing group of 3 (`XXX=`) yields 2, and of 2 (`XX==`) yields
/// 1. The missing positions fold in as zero, so the top bits carry the real
/// bytes in their normal order.
fn base64_decode(input: &str) -> String {
    const TABLE: &str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    let vals: Vec<u32> = input
        .bytes()
        .filter(|&b| b != b'=' && b != b'\n' && b != b'\r')
        .map(|b| {
            TABLE
                .find(b as char)
                .map(|i| i as u32)
                .expect("non-base64 character in escape")
        })
        .collect();
    let mut out: Vec<u8> = Vec::new();
    for group in vals.chunks(4) {
        let len = group.len();
        let n: u32 = group.iter().fold(0u32, |acc, v| acc << 6 | v);
        match len {
            4 => {
                out.push((n >> 16) as u8);
                out.push((n >> 8) as u8);
                out.push(n as u8);
            }
            3 => {
                out.push((n >> 16) as u8);
                out.push((n >> 8) as u8);
            }
            2 => out.push((n >> 16) as u8),
            _ => {}
        }
    }
    String::from_utf8(out).expect("base64 payload is utf-8")
}
}

