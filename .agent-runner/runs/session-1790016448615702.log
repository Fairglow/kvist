///
/// The sequence is `\x1b]52;c;<base64>\x07` (ST via the ANSI bell). Terminals
/// that speak OSC 52 then copy the decoded content to the selection/clipboard.
fn osc52_escape(content: &str) -> String {
    let mut escape = String::with_capacity(content.len() + 16);
    escape.push('\u{1b}');
    escape.push_str("]52;c;");
    escape.push_str(&base64_encode(content.as_bytes()));
    escape.push('\u{7}');
    escape
}

