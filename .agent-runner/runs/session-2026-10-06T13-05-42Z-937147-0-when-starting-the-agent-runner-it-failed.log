tool stdout: {"content":"# Example agent-runner configuration.\nschema_version = 1\n\n# Optional override for the working directory; defaults to the process\n# current directory when omitted. Must be absolute and exist.\nworking_directory = \"/absolute/path/to/your/project\"\n\ndefault_model = \"local\"\ndefault_thinking_effort = \"medium\"\n\n# UI theme: `dark` (default) keeps the classic black panels; `light` is the\n# built-in alternative for light terminals. Both give reasoning a left edge and\n# tint, and highlighted code an indentation plus a patch. The --theme flag\n# overrides this per run, and Ctrl+S cycles themes live.\ntheme = \"dark\"\n\n# Models selectable in the UI with -m/--model.\n[[models]]\nid = \"local\"\nprovider = \"llama-server\"\nbase_url = \"http://127.0.0.1:9931\"\nmodel = \"qwen2.5-14b\"\n# By default discover the selected model's serving context (not training size).\n# Configure this if runtime metadata is absent. CLI overrides take precedence.\n# context_limit = 131072\n# Initial output bound; default min(8192, context_limit/4). Safe length retries\n# may increase it within the context/time/token limits. max_attempts=1 disables retries.\n# response_reserve = 8192\n# Per-turn generation budget. Long-context turns (large prefill plus thousands\n# of generated tokens) can take a couple of minutes; a stalled provider is still\n# caught by the slot/TTFT/cadence watchdogs, so this can be generous.\ndeadline_secs = 300\n# Inter-token cadence watchdog: abort and retry a turn that sends no token for\n# this many seconds after the first token. `0` disables it.\ncadence_timeout_secs = 30\n\n[[models]]\nid = \"ollama\"\nprovider = \"ollama\"\nbase_url = \"http://127.0.0.1:11434\"\nmodel = \"qwen2.5\"\n# An unloaded Ollama model has no discoverable serving context. Set this to the\n# num_ctx actually configured for it, or load it before startup.\n# context_limit = 32768\ndeadline_secs = 300\ncadence_timeout_secs = 30\n\n# The independent sandbox enforcement boundary.\n[sandbox]\nrunner = \"/usr/local/bin/kvist-sandbox-runner\"\nbackend = \"/usr/bin/bwrap\"\n\n# Tool policy. The denylist entries below are appended to the built-in safe\n# minimum, which already forbids clearly destructive commands.\n[tool_policy]\nshell_deny_substrings = []\nshell_deny_prefixes = []\n\n# Per-language tool-chain advertisement. Each key is a configurable profile id\n# (python, rust, javascript, go, c). `Generic` is always present and is not\n# configured. `auto` advertises the profile only when its interpreter reaches the\n# sandbox; `on` advertises and fails at startup when it does not; `off` never\n# advertises. Unknown profile keys and unrecognized settings fail at load.\n[tool_profiles]\npython = \"auto\"\nrust = \"auto\"\njavascript = \"auto\"\ngo = \"auto\"\nc = \"auto\"\n","next_offset":null,"offset":0,"sha256":"sha256:600e0c418fba5c7a5eca0668b247b0f2f47656ab4f112e4938f40e977e80f28a","total_bytes":2691}

