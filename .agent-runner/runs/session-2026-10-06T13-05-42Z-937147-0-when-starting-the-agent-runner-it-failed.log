```rust
pub fn select_active_model(
    config: &Config,
    explicit: Option<&str>,
    active: &std::collections::BTreeMap<String, String>,
) -> Select {
    if let Some(id) = explicit {
        return Select::Explicit(id.to_owned());
    }

    // The default provider's configured models drive the automatic selection:
    // it is the provider queried for its active model, the source of the
    // per-provider default fall-back, and the "single choice" convenience.
    let default_models: Vec<&Model> = config
        .models
        .iter()
        .filter(|model| model.provider == config.default_provider)
        .collect();

    // Rule: a loaded model on the default provider matching a configured entry
    // is reused with no switch (matched by provider model name).
    let mut matched: Vec<&Model> = Vec::new();
    for model in &default_models {
        if let Some(loaded) = active.get(&model.base_url)
            && loaded == &model.model
        {
            matched.push(model);
        }
    }
    if !matched.is_empty() {
        // A unique match selects that entry. Two distinct entries matching the
        // same loaded model is ambiguous and defers.
        let mut seen = std::collections::BTreeSet::new();
        let ambiguous = matched.iter().any(|model| {
            !seen.insert((model.base_url.as_str(), model.model.as_str()))
        });
        if !ambiguous {
            let model = matched[0];
            return Select::Active {
                model_id: model.id.clone(),
                reason: format!(
                    "using already-loaded model `{}` (no switch)",
                    active
                        .get(&model.base_url)
                        .expect("matched entry has an active model")
                ),
                loaded: model.model.clone(),
            };
        }
        return Select::NeedsSelection;
    }

    // No active model on the default provider: fall back to the provider's
    // default model, else a single configured model for that provider.
    if let Some(model) = config.default_model() {
        return Select::Default {
            model_id: model.id.clone(),
            reason: format!(
                "no active model on `{}`; using its configured default model `{}`",
                config.default_provider, model.id
            ),
            loaded: model.model.clone(),
        };
    }
    if default_models.len() == 1 {
        let model = default_models[0];
        return Select::Single {
            model_id: model.id.clone(),
        };
    }

    // Several models for the default provider, no active model, no default: the
    // session must not guess — defer (interactive) or fail (headless).
    Select::NeedsSelection
}
