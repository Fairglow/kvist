```rust
fn select_default_provider(
    config: &Config,
    active: &std::collections::BTreeMap<String, String>,
) -> Select {
    let default_provider = config.default_provider;
    // Models configured for the default provider.
    let provider_models: Vec<&Model> = config
        .models
        .iter()
        .filter(|model| model.provider == default_provider)
        .collect();
    if provider_models.is_empty() {
        // The default provider has no configured models: cannot fall back; ask.
        return Select::NeedsSelection;
    }
    // The default provider already has a loaded model that is not a configured
    // entry (e.g. unconfigured): treat as no usable active model.
    // Single choice: use it.
    if provider_models.len() == 1 {
        let model = provider_models[0];
        return Select::Default {
            model_id: model.id.clone(),
            reason: format!(
                "no active model on the default provider; using its single configured model `{}`",
                model.id
            ),
            loaded: model.model.clone(),
        };
    }
    // Named default model for the provider (exactly one marked default).
    let defaults: Vec<&Model> = provider_models
        .iter()
        .filter(|model| model.is_default)
        .collect();
    if defaults.len() == 1 {
        let model = defaults[0];
        return Select::Default {
            model_id: model.id.clone(),
            reason: format!(
                "no active model on the default provider; using its default model `{}`",
                model.id
            ),
            loaded: model.model.clone(),
        };
    }
    // Several choices and no usable default: ask the user.
    Select::NeedsSelection
}
```

