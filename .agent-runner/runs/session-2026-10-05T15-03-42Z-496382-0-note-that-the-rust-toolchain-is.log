```rust
pub fn resolve_cargo_toolchain(runner: &str) -> Result<ResolvedCargoToolchain> {
    // rustup treats an absolute RUSTUP_TOOLCHAIN as a toolchain *root* and
    // appends `bin/`, which fails if that directory is absent. The sandbox
    // provisions a complete toolchain at the conventional root, so honor it
    // only when present; otherwise defer to rustup's own default resolution
    // (which works on a normal host with a configured default toolchain).
    let mut command = std::process::Command::new("rustup");
