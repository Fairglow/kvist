pub fn resolve_cargo_toolchain(runner: &str) -> Result<ResolvedCargoToolchain> {
    // 1. Let rustup resolve its ambient active/default toolchain. This respects
    //    $HOME, RUSTUP_TOOLCHAIN, and any rust-toolchain.toml, so it works on any
    //    host that actually has a rustup toolchain installed (including a home-layout
    //    sandbox). We do NOT force a specific RUSTUP_TOOLCHAIN, because the toolchain
    //    lives wherever the host installed it — not at a hard-coded path.
    let output = Command::new("rustup")
        .args(["which", "cargo"])
        .env("RUSTUP_OFFLINE", "true")
        .output()
        .map_err(...)?;
    if output.status.success() {
        let cargo_str = ...;
        return cargo_toolchain_from_path(&cargo_str, runner);
    }

    // 2. Fallback for a host where rustup has no default but a toolchain is
    //    provisioned at the sandbox root. Only reachable by naming it explicitly.
    let sandbox_cargo = PathBuf::from("/rust/toolchain/bin/cargo");
    if sandbox_cargo.is_file() {
        return cargo_toolchain_from_path(sandbox_cargo.to_string_lossy(), runner);
    }

    // 3. Nothing resolved.
    Err(...)
}
```

