    // Prefer the root layout (a single RUSTUP_TOOLCHAIN points rustup straight
    // at the tree); if that root is actually a rustup home, fall back to the home.
    if rust_toolchain_root_has_bin() {
        command.env("RUSTUP_TOOLCHAIN", "/rust/toolchain");
    } else {
        command.env("RUSTUP_HOME", "/rust/toolchain");
    }
