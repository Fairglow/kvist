```rust
pub fn resolve_cargo_toolchain(runner: &str) -> Result<ResolvedCargoToolchain> {
    // The provisioned Rust toolchain lives at /rust/toolchain, but different host
    // provisionings expose it in two shapes:
    //   * a toolchain *root* — `<root>/bin/cargo` directly under /rust/toolchain
    //   * a rustup *home*     — `/rust/toolchain/.rustup/toolchains/<ch>/bin/cargo`
    // `rustup which cargo` only accepts a toolchain *root* via RUSTUP_TOOLCHAIN,
    // so point it at the actual root and keep installs off.
    let root = Path::new("/rust/toolchain");
    let target = if root.join("bin").is_dir() {
        root.to_path_buf()
    } else {
        // rustup home: descend to the one channel root that has a bin/.
        let candidates = std::fs::read_dir(root.join(".rustup/toolchains"))
            .ok()
            .into_iter()
            .flatten()
            .filter_map(|e| e.ok())
            .map(|e| e.path())
            .filter(|p| p.join("bin").is_dir())
            .collect::<Vec<_>>();
        candidates.last().ok_or_else(|| KvistError::SandboxUnavailable {
            runner: runner.to_owned(),
            reason: "`rustup which cargo` failed: the path '/rust/toolchain' has no bin/ directory",
        })?
    };

    let mut command = std::process::Command::new("rustup");
    command.args(["which", "cargo"]).env("RUSTUP_TOOLCHAIN", target).env("RUSTUP_OFFLINE", "true");
    ...
}
```

