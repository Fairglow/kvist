            ("CARGO_NET_OFFLINE", "true"),
            ("RUSTC", "/rust/toolchain/bin/rustc"),
            ("RUSTDOC", "/rust/toolchain/bin/rustdoc"),
        ]
        .into_iter()
        .map(|(k, v)| (k.into(), v.into()))
        .collect()
    }
}

