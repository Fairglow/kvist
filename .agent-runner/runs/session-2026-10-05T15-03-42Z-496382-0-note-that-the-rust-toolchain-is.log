    let cargo = PathBuf::from(cargo_output.trim());
    let root = cargo.parent()...;
    let installations = home.join(".rustup/toolchains");
    if root.parent() != Some(installations.as_path()) || cargo != root.join("bin/cargo") ... {
        return Err(...);
    }
    ...
}
```

