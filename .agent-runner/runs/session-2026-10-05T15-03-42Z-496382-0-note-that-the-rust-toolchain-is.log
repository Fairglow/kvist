fn query_rustup(rustup: &Path, home: &Path, args: &[&str], preparation: &Preparation<'_>) -> Result<String> {
    let mut command = Command::new(rustup);
    command
        .args(args)
        .current_dir("/")
        .env_clear()
        .env("HOME", home)
        .env("PATH", "/usr/bin:/bin")
        .env("RUSTUP_AUTO_INSTALL", "0");
