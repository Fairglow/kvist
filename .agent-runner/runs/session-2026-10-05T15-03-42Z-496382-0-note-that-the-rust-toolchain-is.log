```rust
/// Well-known mount for the host-provisioned Rust toolchain inside the
/// sandbox. It exists only in the sandbox; the host has no `/rust`. Consult it
/// only when the ambient rustup selection has no active toolchain, so the host
/// never resolves a path that is absent.
const PROVISIONED_TOOLCHAIN_ROOT: &str = "/rust/toolchain";

/// Locate the immutable Rust toolchain (cargo, rustc, rustlib, linker) so an
/// offline `cargo` build can mount the whole toolchain read-only.
///
/// Resolution prefers the ambient rustup selection (the host's configured
/// default) and only consults the provisioned `/rust/toolchain` mount when
/// that selection is unavailable. It never installs, upgrades, or modifies a
/// toolchain, and it never reaches the network. Resolution fails closed with a
/// non-secret, actionable message when neither source yields a toolchain.
pub fn resolve_cargo_toolchain(runner: &str) -> Result<ResolvedCargoToolchain> {
    // Prefer the ambient rustup selection so the host resolves its configured
    // default without any hardcoded path.
    match which_cargo(runner, None) {
        Ok(toolchain) => return Ok(toolchain),
        // The ambient selection is unavailable (e.g. no active toolchain).
        Err(ambient_err) => {
            // When a provisioned toolchain tree is mounted, consult it
            // explicitly. The path is only used when present, so the host
            // (which has no `/rust`) never resolves a nonexistent location.
            if Path::new(PROVISIONED_TOOLCHAIN_ROOT).is_dir() {
                if let Ok(toolchain) = which_cargo(runner, Some(PROVISIONED_TOOLCHAIN_ROOT)) {
                    return Ok(toolchain);
                }
            }
            Err(ambient_err)
        }
    }
}

/// Run `rustup which cargo` and resolve the returned path to a toolchain.
///
/// When `toolchain` is `Some`, the invocation is bound to that toolchain
/// root (the provisioned mount); otherwise rustup uses its ambient selection.
/// `RUSTUP_OFFLINE` keeps resolution from ever reaching the network.
fn which_cargo(
    runner: &str,
    toolchain: Option<&str>,
) -> Result<ResolvedCargoToolchain> {
    let mut command = std::process::Command::new("rustup");
    command.args(["which", "cargo"]);
    if let Some(tc) = toolchain {
        command.env("RUSTUP_TOOLCHAIN", tc);
    }
    command.env("RUSTUP_OFFLINE", "true");
    let output = command
        .output()
        .map_err(|source| KvistError::SandboxUnavailable {
            runner: runner.to_owned(),
            reason: format!("cannot invoke rustup to locate the Rust toolchain: {source}"),
        })?;
    if !output.status.success() {
        let stderr = String::from_utf8_lossy(&output.stderr);
        return Err(KvistError::SandboxUnavailable {
            runner: runner.to_owned(),
            reason: format!("`rustup which cargo` failed: {}", stderr.trim()),
        });
    }
    let cargo_str = String::from_utf8_lossy(&output.stdout).trim().to_owned();
    if cargo_str.is_empty() {
        return Err(KvistError::SandboxUnavailable {
            runner: runner.to_owned(),
            reason: "`rustup which cargo` returned no toolchain path".to_owned(),
        });
    }
    cargo_toolchain_from_path(&cargo_str, runner)
}
```

