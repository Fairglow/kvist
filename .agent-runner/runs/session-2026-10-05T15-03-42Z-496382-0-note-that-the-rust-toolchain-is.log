        let resolved = resolve_config_path_with(None, Some(empty), env)
            .expect("first XDG_CONFIG_DIRS entry resolves");
        assert_eq!(resolved, system_file);
    }

    #[test]
    fn resolve_config_path_reports_when_nothing_exists() {
