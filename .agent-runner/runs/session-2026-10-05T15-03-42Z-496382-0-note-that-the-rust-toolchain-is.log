fn provisioned_toolchain_root() -> Option<PathBuf> {
    let base = Path::new("/rust/toolchain");
    if base.join("bin/cargo").is_file() && (base.join("lib/rustlib").is_dir() || base.join("rustlib").is_dir()) {
        return Some(base.to_path_buf()); // root layout
    }
    // home layout: pick the single channel root
    let channels = base.join(".rustup").join("toolchains");
    if channels.is_dir() {
        if let Ok(entries) = fs::read_dir(&channels) {
            for entry in entries.flatten() {
                let p = entry.path();
                if p.join("bin/cargo").is_file() {
                    return Some(p);
                }
            }
        }
    }
    None
}
```

