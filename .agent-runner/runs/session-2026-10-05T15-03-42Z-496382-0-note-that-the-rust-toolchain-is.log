            // provisioned toolchain tree is mounted at the well-known path,
            // consult it explicitly rather than failing closed on the ambient
            // selection.
            match try_resolve_provisioned_rustup(runner) {
                Ok(toolchain) => Ok(toolchain),
                Err(_) => Err(ambient),
            }
        }
    }
}
