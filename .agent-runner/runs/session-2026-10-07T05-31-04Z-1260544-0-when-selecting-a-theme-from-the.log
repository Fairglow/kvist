    match std::fs::canonicalize(path) {$
        Ok(canonical) => Ok(canonical),$
        Err(source) if source.kind() == std::io::ErrorKind::NotFound => Ok(path.to_path_buf()),$
        Err(source) => Err(KvistError::Io {$
