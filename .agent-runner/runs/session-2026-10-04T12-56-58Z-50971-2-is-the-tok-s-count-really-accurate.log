```rust
/// Formats a non-negative count with the conventional k/M/G compact units
/// (two significant decimals, e.g. `52`, `996`, `1.02k`, `1.02M`), the same
/// style used for token figures in most developer tools.
fn format_number(value: f64) -> String {
    let value = if value.is_finite() && value > 0.0 { value } else { 0.0 };
    match value {
        v if v < 1000.0 => format!("{v:.0}"),
        v if v < 1_000_000.0 => format!("{:.2}k", v / 1000.0),
        v if v < 1_000_000_000.0 => format!("{:.2}M", v / 1_000_000_000.0),
        _ => format!("{:.2}G", value / 1_000_000_000_000.0),
    }
}
```

