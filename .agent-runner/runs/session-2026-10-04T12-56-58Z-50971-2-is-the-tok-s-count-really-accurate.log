+/// Values below 1000 print as exact integers so small counts stay exact.
+fn format_number(n: f64) -> String {
+    if !n.is_finite() || n < 1000.0 {
+        return format!("{:.0}", n.max(0.0));
+    }
+    let (divisors, suffixes) = [
+        (1_000.0, "k"),
+        (1_000_000.0, "M"),
+        (1_000_000_000.0, "G"),
+    ];
+    let (divisor, suffix) = divisors
+        .iter()
+        .zip(suffixes.iter())
+        .rev()
+        .find(|(divisor, _)| n >= *divisor)
+        .unwrap();
+    let value = n / divisor;
