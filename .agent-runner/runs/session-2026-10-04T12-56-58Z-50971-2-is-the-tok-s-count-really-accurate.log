        format!("compact {} {:>3.0}%{}", bargraph(compaction_progress,8), compaction_progress*100, eta)
    } else { String::new() };
    let usage = match token_accounting {
        Provider => format!("Σ {} tok", format_tokens(total_tokens)),
        Estimated => format!("Σ ~{} tok", format_tokens(total_tokens)),
        Unavailable => "Σ n/a".into(),
