Now `format_tokens`:
```
fn format_tokens(n: u64) -> String {
    if n < 1000 { return n.to_string(); }
    if n < 1_000_000 { return trim1(n as f64 / 1000.0).to_string() + "k"; }
    trim1(n as f64 / 1_000_000.0) + "M"
}
fn trim1(x: f64) -> String {
    let s = format!("{:.1}", x);
    s.strip_suffix('.0').map(String::from).unwrap_or(s)
}
```
