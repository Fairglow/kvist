                eta_suffix
            ));
        }
        let usage_part = match stats.token_accounting {
            crate::session::TokenAccounting::Provider => {
                format!("{:>9} tok", format_number(stats.total_tokens as f64))
            }
            crate::session::TokenAccounting::Estimated => {
