    sink: &S,
    progress: &LiveProgress,
    output_chars: u64,
    at: Instant,
) -> Result<()> {
    let output_tokens = output_chars.div_ceil(4);
    let elapsed = at
        .saturating_duration_since(progress.started_at)
        .as_secs_f64()
        .max(1e-9);
