            let eta_suffix = match stats.eta_secs {
                Some(secs) => format!(" (in {})", format_eta(secs)),
                None => String::new(),
            };
            parts.push(format!(
                "compaction {}{:.0}%{}",
                bargraph(stats.compaction_progress, 8),
