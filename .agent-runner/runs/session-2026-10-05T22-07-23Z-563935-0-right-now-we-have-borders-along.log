fn restyled_style(&self, from: &Theme, line: &Line<'static>, kind: LineKind) -> Style {
    let fg = line.spans.first().and_then(|s| s.style.fg);
    let bold = line.spans.first().is_some_and(|s| s.style.add_modifier.contains(Modifier::BOLD));
    match kind {
        LineKind::Reasoning | LineKind::PlaceholderContinuation => self.theme.reasoning,
        LineKind::Placeholder => self.theme.reasoning_placeholder,
        LineKind::Normal => {
            if bold && Some(from.prompt.fg) == fg { return self.theme.prompt; }
            let color = ... map fg to semantic:
            if Some(from.ok) == fg { self.theme.ok } else if Some(from.warn) == fg { self.theme.warn } ... 
        }
    }
}
