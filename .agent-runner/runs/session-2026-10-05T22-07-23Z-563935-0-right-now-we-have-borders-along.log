2. render_transcript:
```rust
fn render_transcript(f: &mut ratatui::Frame, app: &App, area: Rect) {
    // A top-only border: the left/right edges were borders before; now the
    // panels open on the sides so a full content row (and the scrollbar) fits.
    let inner_width = usize::from(area.width);
    let inner_height = area.height.saturating_sub(1).max(1) as usize; // -1 top border
    let lines: Vec<Line> = app.lines.iter()
        .map(|screen_line| full_width_line(&screen_line.line, &app.theme, inner_width))
        .collect();
    let block = Block::default()
        .borders(Borders::TOP)
        .border_style(Style::default().fg(app.theme.panel_border))
        .title(Span::styled(
            format!(" transcript [{}] · {}", app.lines.len(), app.theme.name),
            app.theme.dim,
        ));
    let paragraph = Paragraph::new(Text::from(lines))
        .block(block)
        .scroll((app.scroll, 0));
    f.render_widget(paragraph, area);
    // Always-visible scrollbar riding the right edge, adapted to the current
    // window (viewport = inner height, position = scroll offset).
    let content_length = app.lines.len().max(inner_height);
    let offset = (app.scroll as usize).min(app.lines.len().saturating_sub(inner_height));
    let mut state = ScrollbarState::new(content_length)
        .position(offset)
        .viewport_content_length(inner_height);
    let bar_area = Rect::new(area.right() - 1, area.top() + 1, 1, area.height.saturating_sub(1));
    f.render_stateful_widget(
        Scrollbar::new(ScrollbarOrientation::VerticalRight)
            .begin_symbol(Some("▲"))
            .end_symbol(Some("▼"))
            .track_symbol(Some("│"))
            .style(app.theme.scrollbar),
        bar_area,
        &mut state,
    );
}
```

Wait, the title format was previously " transcript [N] ". Add "· dark" — good touch: shows the active theme. `format!(" transcript [{}] · {} ", ...)`.

Edge case: area.height 0 → bar_area height 0 → Rect with height 0; ratatui handles it (renders nothing). top+1 when area.height=0 → top+1 > area.bottom → Rect::new with height 0 — fine as long as height is saturating_sub(1) = 0.

