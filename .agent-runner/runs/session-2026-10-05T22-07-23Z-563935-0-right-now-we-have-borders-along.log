    /// While the view is pinned to the bottom (auto-follow), keep it pinned as
    /// new lines are appended. Escaping upward with a scroll unpins this.
    fn follow(&mut self) {
        if self.following {
            self.scroll = self.bottom_offset();
        }
    }

    fn clear_screen(&mut self) {
        self.lines.clear();
        self.scroll = 0;
