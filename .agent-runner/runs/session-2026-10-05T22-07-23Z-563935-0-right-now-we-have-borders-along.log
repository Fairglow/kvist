/// One visual transcript row and a flag indicating whether it is code.
#[derive(Debug, Clone)]
pub struct RenderedLine {
    pub line: Line<'static>,
    pub is_code: bool,
}

/// The theme-derived colors the transcript needs to frame blocks that must
/// stand out from the standard text background: the prompt area, the
/// reasoning block, and the syntax-highlighted code block.
///
/// Everything else — normal text, tool rows, notices — is drawn on the
/// terminal's own (black) background. So that blocks are visible on any
/// terminal, a theme always supplies all three colors; the default dark theme
/// is tuned for dark terminals, and the light theme for light ones.
#[derive(Debug, Clone, Copy)]
pub struct ThemeColors {
    /// The background of the user's prompt block.
    pub prompt_bg: Color,
    /// The background of the reasoning block, with a left edge marker.
    pub reasoning_bg: Color,
    /// The marker on the left edge of the reasoning block.
    pub reasoning_edge: Color,
    /// The background of the syntax-highlighted code block.
    pub code_bg: Color,
}

impl ThemeColors {
    /// The default (dark) theme colors: subdued tints on a black background,
    /// chosen so that standard foregrounds retain sufficient contrast.
    pub const fn dark() -> Self { ... }
    /// Colors of the light theme ...
    pub const fn light() -> Self { ... }
}

/// The color choices the transcript makes that are specific to a theme.
/// The Markdown structure's foreground colors (headings, links, bullets,
/// tables) stay constant across themes: they read well on both the black
/// terminal background (the default theme) and on the light theme's block
/// backgrounds.
#[derive(Debug, Clone)]
pub struct MarkdownPalette {
    pub theme: ThemeColors,
    pub styles: MarkdownStyles,
    /// The syntect theme used to colorize code blocks; its background is
    /// replaced with [`ThemeColors::code_bg`] so that the code block aligns
    /// with the theme's block background.
    pub syntax: Theme,
}
```

