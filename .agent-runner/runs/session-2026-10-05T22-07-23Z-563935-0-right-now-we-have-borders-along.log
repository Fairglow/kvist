    fn new_session(&mut self) {
        self.clear_screen();
        self.following = true;
        self.status = "idle".to_owned();
        self.note(
            Style::default().fg(Color::Cyan),
            "new session — transcript cleared, model conversation restarted; type a prompt below",
            AGENT_BG,
        );
    }

