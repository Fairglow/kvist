TS: [ReasoningEffort; 7] = [\n    ReasoningEffort::None,\n    ReasoningEffort::Minimal,\n    ReasoningEffort::Low,\n    ReasoningEffort::Medium,\n    ReasoningEffort::High,\n    ReasoningEffort::Xhigh,\n    Reasoni","next_offset":4096,"offset":0,"sha256":"sha256:b6bbd97c2ba4eaecad595fca82760a868aed5cace529f5d1b896810e484db4e0","total_bytes":130420}

