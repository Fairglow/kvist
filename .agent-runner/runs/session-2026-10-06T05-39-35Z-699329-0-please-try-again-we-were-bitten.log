/// The provider-facing name of the single model the provider has loaded (if
/// exactly one), plus its advertised serving context when the provider reports
/// one. Read-only, loopback-only, bounded. A down/malformed provider or an
/// ambiguous (multi-model) state is None.
pub fn loaded_model(&self, cancellation: &CancellationToken) -> Result<Option<(String, Option<usize>)>> {
    let path = match self.provider {
        LlamaServer => "/v1/models",
        Ollama => "/api/ps",
    };
    let bytes = get_bounded(&format!("http://{}", self.endpoint.authority), path, self.deadline.min(Duration::from_secs(5)), 1024*1024, cancellation)?;
    let value = parse_json(&bytes)?;
    if !value.is_object() { return Ok(None); }  // malformed → treat as none (fall-through)
    match self.provider {
        Ollama => {
            let models = value.get("models").and_then(Value::as_array).ok_or(malformed)?;
            // at most a handful; pick single
            if models.len() != 1 { return Ok(None); }
            let m = &models[0];
            let name = m.get("name").or(m.get("model")).and_then(Value::as_str).ok_or(malformed)?;
            let ctx = m.get("context_length").and_then(Value::as_u64).map(|n| n as usize);
            Ok(Some((name.to_owned(), ctx)))
        }
        LlamaServer => {
            let data = value.get("data").and_then(Value::as_array).ok_or(malformed)?;
            if data.len() != 1 { return Ok(None); }
            let id = data[0].get("id").and_then(Value::as_str).ok_or(malformed)?;
            Ok(Some((id.to_owned(), None)))  // context via context_limit separately
        }
    }
}
```

