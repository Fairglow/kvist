pub enum Select {
    Explicit(String),
    Active { model_id: String, reason: String, loaded: String },
    Single { model_id: String },
    NeedsSelection,
}

pub struct ModelSelectionContext {
    pub active: BTreeMap<String, String>,   // base_url -> loaded provider model name
    pub unconfigured: Vec<(String, String)>, // (loaded provider model name, base_url) for the offer
