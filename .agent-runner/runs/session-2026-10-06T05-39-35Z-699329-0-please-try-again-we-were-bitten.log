```rust
/// Reports the provider-facing name of the model the provider currently has
/// loaded, without inference. llama-server answers a model-qualified `/props`
/// only for the model it has loaded, so the probed name is reported as loaded;
/// Ollama reports its loaded model from `/api/ps`. A provider that is down,
/// busy, or has no model loaded yields `None` so callers can fall through.
pub fn loaded_model_name(
    &self,
    model: &str,
    cancellation: &CancellationToken,
) -> Result<Option<String>> {
    match self.provider {
        LocalModelProvider::LlamaServer => {
            if model.trim().is_empty() || model.len() > 256 || model.chars().any(char::is_control) {
                return invalid_request("active-model probe requires a bounded nonblank model id");
            }
            let path = format!("/props?model={}", query_component(model));
            match get_bounded(
                &format!("http://{}", self.endpoint.authority),
                &path,
                self.deadline.min(MAX_CAPACITY_DISCOVERY),
                1024 * 1024,
                cancellation,
            ) {
                Ok(_) => Ok(Some(model.to_owned())),
                Err(_) => Ok(None),
            }
        }
        LocalModelProvider::Ollama => {
            let bytes = get_bounded(
                &format!("http://{}", self.endpoint.authority),
                "/api/ps",
                self.deadline.min(MAX_CAPACITY_DISCOVERY),
                1024 * 1024,
                cancellation,
            )?;
            let value = parse_json(&bytes)?;
            if !value.is_object() {
                return Ok(None);
            }
            let Some(models) = value.get("models").and_then(Value::as_array) else {
                return Ok(None);
            };
            if models.len() > 128 {
                return Ok(None);
            }
            let name = models.iter().find_map(|entry| {
                ["name", "model"]
                    .iter()
                    .find_map(|key| entry.get(*key).and_then(Value::as_str))
            });
            Ok(name.map(str::to_owned))
        }
    }
}
```

