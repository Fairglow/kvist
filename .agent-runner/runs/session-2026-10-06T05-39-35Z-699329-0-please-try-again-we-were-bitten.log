   125	fn render_transcript(f: &mut ratatui::Frame, app: &App, area: Rect) {
   126	    // The panel's single top edge consumes no columns; the full width is the
   127	    // inner content every transcript row's background must fill.
   128	    let inner_width = usize::from(area.width.max(1));
   129	    let lines: Vec<Line> = app
   130	        .lines
   131	        .iter()
   132	        .map(|screen_line| full_width_line(&screen_line.line, screen_line.bg, inner_width))
   133	        .collect();
   134	    let block = Block::default()
   135	        .borders(Borders::TOP)
   136	        .border_style(Style::default().fg(app.theme.panel_border))
   137	        .title(Span::styled(
   138	            format!(" transcript [{}] ", app.lines.len()),
   139	            Style::default().fg(app.theme.dim),
   140	        ));
   141	    let paragraph = Paragraph::new(Text::from(lines))
   142	        .block(block)
   143	        .scroll((app.scroll, 0));
   144	    f.render_widget(paragraph, area);
   145	    // The scrollbar is always present and adaptive: its track spans the
   146	    // panel's inner height, and its thumb encodes the current window into the
   147	    // full transcript (content length, viewport, and offset), so its size and
   148	    // position track both scrolling and terminal resizes. It rides the inner
   149	    // right column (the panel has no right border, so this column is not
   150	    // content the transcript rows pad past).
   151	    let viewport = area.height.saturating_sub(1).max(1);
   152	    let content_length = app.lines.len().max(usize::from(viewport));
   153	    let offset = (app.scroll as usize).min(app.lines.len().saturating_sub(usize::from(viewport)));
   154	    let mut state = ScrollbarState::new(content_length)
   155	        .position(offset)
   156	        .viewport_content_length(usize::from(viewport));
   157	    let bar_area = Rect::new(area.right().saturating_sub(1), area.top() + 1, 1, viewport);
   158	    f.render_stateful_widget(
   159	        Scrollbar::new(ScrollbarOrientation::VerticalRight)
   160	            .begin_symbol(Some("▲"))
   161	            .end_symbol(Some("▼"))
   162	            .track_symbol(Some("│"))
   163	            .style(app.theme.scrollbar),
   164	        bar_area,
   165	        &mut state,
   166	    );
   167	}
