fn panel_top_edge(title: String, border: Style, title_style: Style, width: usize) -> Line<'static> {
    let lead = "──";
    let fill = width.saturating_sub(lead.chars().count() + title.len());
    Line::from(vec![
        Span::styled(lead, border),
        Span::styled(title, title_style),
        Span::styled("─".repeat(fill), border),
    ])
}
