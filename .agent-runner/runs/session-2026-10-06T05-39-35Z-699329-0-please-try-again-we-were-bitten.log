```rust
/// A panel's single top edge title: a leading border-colored dash (so the
/// edge reads as a border line from the left), followed by the label.
fn top_title<'a>(label: &str, label_style: Style, border: Color) -> Line<'a> {
    Line::from(vec![
        Span::styled("─", Style::default().fg(border)),
        Span::styled(label, label_style),
    ])
}
```

