pub fn select_active_model(config: &Config, explicit: Option<&str>, active: &BTreeMap<String, String>) -> Select {
    if let Some(id) = explicit { return Select::Explicit(id.to_owned()); }
    // rule 2: a loaded model matching a configured entry's provider name
    let matches: Vec<&Model> = active.iter().flat_map(|(url, name)|
        config.models.iter().filter(|m| &m.base_url == url && &m.model == name)
    ).collect();
    if matches.len() == 1 {
        return Select::Active {
            model_id: matches[0].id.clone(),
            reason: "active".into(),
            loaded: matches[0].model.clone(),
        };
    }
    // rule 3: single configured model
    if config.models.len() == 1 {
        return Select::Single { model_id: config.models[0].id.clone() };
    }
    // rule 4
    Select::NeedsSelection
}
