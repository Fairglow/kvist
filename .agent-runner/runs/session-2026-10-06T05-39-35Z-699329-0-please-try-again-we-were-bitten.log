    91	fn render_header(f: &mut ratatui::Frame, app: &App, area: Rect) {
    92	    // A leading spinner that advances with wall-clock time gives a motion cue
    93	    // an idle header lacks, so "is it working?" is answerable at a glance: it
    94	    // spins only while a turn generates and stops on any terminal event.
    95	    let spinner = match app.spinner() {
    96	        Some(frame) => Span::styled(frame, Style::default().fg(app.theme.spinner).bold()),
    97	        None => Span::from(" "),
    98	    };
    99	    let model = if app.running {
   100	        app.theme.model_active
   101	    } else {
   102	        app.theme.model
   103	    };
   104	    let title = Line::from(vec![
   105	        Span::styled(
   106	            format!("{} [{}] model: ", spinner, app.execution_scope.label()),
   107	            app.theme.title,
   108	        ),
   109	        Span::styled(
   110	            app.model.clone(),
   111	            app.theme.title.patch(Style::default().fg(model)),
   112	        ),
   113	        Span::styled(
   114	            format!(" · thinking: {} · {}", app.effort.as_str(), app.status),
   115	            app.theme.title,
   116	        ),
   117	    ]);
   118	    let block = Block::default()
   119	        .borders(Borders::BOTTOM)
   120	        .border_style(Style::default().fg(app.theme.panel_border))
   121	        .title(title);
   122	    f.render_widget(block, area);
   123	}
