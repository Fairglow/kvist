   393	
   394	fn visible_overlay_rows<'a>(
   395	    lines: impl Iterator<Item = Line<'a>> + Clone,
   396	    width: u16,
   397	    height: u16,
   398	    offset: usize,
   399	) -> Vec<Line<'static>> {
   400	    let count = lines
   401	        .clone()
   402	        .map(|line| wrap(&line.to_string(), usize::from(width)).len())
   403	        .sum::<usize>();
   404	    let start = offset.min(count.saturating_sub(usize::from(height)));
   405	    lines
   406	        .flat_map(|line| {
   407	            let style = line
   408	                .spans
   409	                .first()
   410	                .map_or(line.style, |span| line.style.patch(span.style));
   411	            wrap(&line.to_string(), usize::from(width))
   412	                .into_iter()
   413	                .map(move |text| Line::styled(text, style))
   414	        })
   415	        .skip(start)
   416	        .take(usize::from(height))
   417	        .collect()
   418	}
