        if let Err(error) = &result {
            summary.failure = Some(error.describe());
        }
        if summary.cancelled || summary.budget_exhausted || summary.failure.is_some() {
            summary.answer = None;
            session.answer = None;
        }
        if let Some(recorder) = recorder.as_mut()
