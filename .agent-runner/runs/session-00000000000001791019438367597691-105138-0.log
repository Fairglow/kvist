                self.working_directory
                    .join(crate::session_log::DEFAULT_LOG_DIR)
            });
            Some(Box::new(
                SessionLog::open(&dir, format!("agent-runner-{}", model.id))
                    .map_err(|source| {
                        crate::error::io_error(
                            "open private session log directory",
                            Some(&dir.to_string_lossy()),
                            source,
                        )
