# this many seconds after the first token. `0` disables it.
cadence_timeout_secs = 30

[[models]]
id = "ollama"
provider = "ollama"
base_url = "http://127.0.0.1:11434"
model = "qwen2.5"
# An unloaded Ollama model has no discoverable serving context. Set this to the
# num_ctx actually configured for it, or load it before startup.
# context_limit = 32768
deadline_secs = 300
cadence_timeout_secs = 30

# The independent sandbox enforcement boundary.
[sandbox]
runner = "/usr/local/bin/kvist-sandbox-runner"
backend = "/usr/bin/bwrap"

# Tool policy. The denylist entries below are appended to the built-in safe
# minimum, which already forbids clearly destructive commands.
[tool_policy]
shell_deny_substrings = []
shell_deny_prefixes = []

# Per-language tool-chain advertisement. Each key is a configurable profile id
# (python, rust, javascript, go, c). `Generic` is always present and is not
# configured. `auto` advertises the profile only when its interpreter reaches the
# sandbox; `on` advertises and fails at startup when it does not; `off` never
# advertises. Unknown profile keys and unrecognized settings fail at load.
[tool_profiles]
python = "auto"
rust = "auto"
javascript = "auto"
go = "auto"
c = "auto"
