on runs.\n#[derive(Debug, Clone, Serialize)]\n#[serde(tag = \"type\", content = \"data\", rename_all = \"snake_case\")]\npub enum Event {\n    /// A model turn began.\n    TurnStart { model: String },\n    /// A fresh model attempt; st","next_offset":4096,"offset":0,"sha256":"sha256:6c56078993954aca624f315c836741c40dd78b13ecb4bdfcbfd0fba644417db9","total_bytes":50879}

