And:
```rust
fn run_prompt_with_agent_runner(
    prompt: &str,
    role_name: &str,
    model: Option<&str>,
    reasoning_effort: Option<agent_runtime::ReasoningEffort>,
    allow_host_execution: bool,
    multi_turn: bool,
) -> Result<()> {
    let interactive = std::io::stdin().is_terminal();
    if allow_host_execution && !interactive {
        return Err(KvistError::AgentSetupFailed {
            reason: "--allow-host-execution requires an interactive terminal; \
            non-interactive prompts run sandboxed via `agent-runner --headless`. \
            Remove the flag to continue.".into(),
        });
    }
    let binary = resolve_agent_runner().map_err(|reason| KvistError::AgentSetupFailed { reason: format!("could not start agent-runner: {reason}") })?;
    let current_dir = std::env::current_dir().map_err(...)?;
    let config = crate::config::load(&current_dir)?;
    let role_config = resolve_role_config(&config, role_name)?;
    let model = model.or(Some(role_config.profile.as_str()));
    let effort = reasoning_effort.or(role_config.thinking_effort);
    let mut command = std::process::Command::new(&binary);
    command.stdin(inherit).stdout(inherit).stderr(inherit).current_dir(&current_dir);
    if !interactive {
        command.arg("--headless").arg("--json");
    }
    if let Some(model) { command.arg("--model").arg(model); }
    if let Some(effort) { command.arg("--effort").arg(effort.as_str()); }
    if allow_host_execution {
        command.arg("--allow-host-execution");
        if multi_turn { command.arg("--host-turns").arg(HOST_AUTONOMOUS_CAP.to_string()); }
    }
    command.arg(prompt);
    let status = command.status().map_err(...)?;
    if !status.success() { return Err(KvistError::AgentSetupFailed { reason: format!("agent-runner exited with status {status}") }); }
    Ok(())
}
```

Wait — the order of arguments for agent-runner: `--headless` requires a positional prompt (clap `requires = "prompt"`) — it's a flag with a requires constraint, so it works in any order. `--json` requires headless. `--model` before headless is fine. OK.

