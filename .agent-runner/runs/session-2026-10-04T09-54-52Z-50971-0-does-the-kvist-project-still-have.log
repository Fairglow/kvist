The headless delegation helper is:

```rust
/// Runs a custom prompt via the standalone `agent-runner` without a terminal,
/// in headless mode: sandbox-only, recording required, version-1 NDJSON on
/// standard output. Kvist supplies the authored prompt and the preselected
/// model and thinking effort, and inherits the child's stdio, so the NDJSON
/// stream is Kvist's output; the child's exit status is surfaced.
fn delegate_headless_prompt(
    prompt: &str,
    role_name: &str,
    model: Option<&str>,
    effort: Option<agent_runtime::ReasoningEffort>,
) -> Result<()> {
    let binary = resolve_agent_runner().map_err(|reason| KvistError::AgentSetupFailed {
        reason: format!("agent-runner is required for headless prompt execution: {reason}"),
    })?;

    let current_dir = std::env::current_dir().map_err(|source| KvistError::Io {
        operation: "determine current project directory",
        path: PathBuf::from("."),
        source,
    })?;
    let config = crate::config::load(&current_dir)?;
    // Preselect the model the role is configured to use; an explicit `--model`
    // override wins. The id must exist in agent-runner's own configuration.
    let model = model.or(Some(role_config.profile.as_str()));
    let effort = effort.or(Some(role_config.thinking_effort));

    let mut command = std::process::Command::new(&binary);
    command
        .stdin(std::process::Stdio::inherit())
        .stdout(std::process::Stdio::inherit())
        .stderr(std::process::Stdio::inherit())
        .current_dir(&current_dir)
        .arg("--headless")
        .arg("--json");
    if let Some(model) = model {
        command.arg("--model").arg(model);
    }
    if let Some(effort) = effort {
        command.arg("--effort").arg(effort.as_str());
    }
    // The prompt is positional; agent-runner runs it as one headless prompt.
    command.arg(prompt);

    let status = command.status().map_err(|source| KvistError::Io {
        operation: "run agent-runner",
        path: binary,
        source,
    })?;
    if !status.success() {
        return Err(KvistError::AgentSetupFailed {
            reason: format!("agent-runner exited with status {status}"),
        });
    }
    Ok(())
}
```

