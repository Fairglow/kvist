Command::Prompt { prompt, file, editor, role, model, reasoning_effort, allow_host_execution, multi_turn } => {
    let resolved_prompt = prompt_input::resolve(prompt, file.as_deref(), editor)?;

    if std::io::stdin().is_terminal() {
        // Interactive custom prompt work runs in the standalone agent-runner
        // shell. Kvist authors the prompt and preselects the model/effort;
        // agent-runner owns the interactive transcript and the execution scope,
        // and its stdio is inherited so the shell is the view. By default the
        // sandbox confines and multiplies the work; --allow-host-execution
        // opts out of the sandbox with host privileges (single-turn unless
        // --multi-turn).
        delegate_interactive_prompt(
            &resolved_prompt,
            &role,
            model.as_deref(),
            reasoning_effort.map(Into::into),
            allow_host_execution,
            multi_turn,
        )?;
    } else {
        if allow_host_execution {
            return Err(KvistError::AgentSetupFailed {
                reason: "--allow-host-execution requires an interactive terminal; host execution is an interactive opt-out. Run without the flag to use the sandboxed headless agent-runner, or interactively to acknowledge host execution".to_owned(),
            });
